#Область HTTP

Функция СоздатьСоединение(Хост, Порт, CACert)
	Защищенное = Неопределено;
	Если ЗначениеЗаполнено(CACert) Тогда
		ЦА = Новый СертификатыУдостоверяющихЦентровOpenSSL(Новый ДвоичныеДанные(CACert));
		Защищенное = Новый ЗащищенноеСоединениеOpenSSL(, ЦА);
	Иначе
		Защищенное = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;
	Возврат Новый HTTPСоединение(Хост, Порт, , , , 60, Защищенное);
КонецФункции

Функция СоздатьЗапрос(Путь, Заголовки, Авторизация)
	ЗаголовкиЗапроса = Новый Соответствие;
	Для Каждого КЗ Из Заголовки Цикл
		// host выставляется платформой автоматически; не дублируем
		Если НРег(КЗ.Ключ) <> "host" Тогда
			ЗаголовкиЗапроса.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	ЗаголовкиЗапроса.Вставить("Authorization", Авторизация);
	Возврат Новый HTTPЗапрос(Путь, ЗаголовкиЗапроса);
КонецФункции

Процедура ПроверитьОтвет(Ответ, Контекст)
	Если Ответ.КодСостояния >= 300 Тогда
		Тело = "";
		Попытка
			Тело = Ответ.ПолучитьТелоКакСтроку();
		Исключение
		КонецПопытки;
		ВызватьИсключение Контекст + ": HTTP " + Ответ.КодСостояния + " " + Лев(Тело, 500);
	КонецЕсли;
КонецПроцедуры

Функция ХостИзURL(URL)
	Б = СтрЗаменить(СтрЗаменить(URL, "https://", ""), "http://", "");
	Поз = СтрНайти(Б, "/");
	Если Поз > 0 Тогда
		Б = Лев(Б, Поз - 1);
	КонецЕсли;
	Поз = СтрНайти(Б, ":");
	Если Поз > 0 Тогда
		Б = Лев(Б, Поз - 1);
	КонецЕсли;
	Возврат Б;
КонецФункции

Функция ПутьИзURL(URL)
	Б = СтрЗаменить(СтрЗаменить(URL, "https://", ""), "http://", "");
	Поз = СтрНайти(Б, "/");
	Если Поз > 0 Тогда
		Возврат Сред(Б, Поз);
	КонецЕсли;
	Возврат "/";
КонецФункции

// Кодирование сегментов пути для S3 (RFC3986, без кодирования "/").
Функция КодироватьПутьS3(Путь)
	Части = СтрРазделить(Путь, "/", Ложь);
	Результат = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Результат.Добавить(КодироватьСтроку(Часть, СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;
	Возврат СтрСоединить(Результат, "/");
КонецФункции

Функция СериализоватьВСтроку(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

