// Возвращает Соответствие(имяКолонки -> тип) для таблицы ClickHouse.
// Пустое — таблицы нет.
Функция ПолучитьКолонкиТаблицыClickHouse(КонфигCH, ИмяТаблицы) Экспорт
	Тело = "SELECT name, type FROM system.columns WHERE database = '" + КонфигCH.База
		+ "' AND table = '" + ИмяТаблицы + "' FORMAT JSONEachRow";
	ОтветТекст = ВыполнитьЗапросClickHouse(КонфигCH, Тело);
	Колонки = Новый Соответствие;
	Для Каждого Линия Из СтрРазделить(ОтветТекст, Символы.ПС, Ложь) Цикл
		Если ПустаяСтрока(Линия) Тогда
			Продолжить;
		КонецЕсли;
		Объект = РазобратьJSONСтроку(Линия);
		Если Объект <> Неопределено Тогда
			Колонки.Вставить(Объект.Получить("name"), Объект.Получить("type"));
		КонецЕсли;
	КонецЦикла;
	Возврат Колонки;
КонецФункции

// Возвращает массив имён ключевых атрибутов таблицы YDB (Document API DescribeTable).
// Исключение — если таблицы нет/недоступна.
Функция КлючиТаблицыYDB(КонфигYDB, ИмяТаблицы) Экспорт
	ТелоСтр = Новый Соответствие;
	ТелоСтр.Вставить("TableName", ИмяТаблицы);
	ОтветТекст = ВыполнитьYDB(КонфигYDB, "DynamoDB_20120810.DescribeTable", СериализоватьВСтроку(ТелоСтр));
	Описание = РазобратьJSONСтроку(ОтветТекст);
	Ключи = Новый Массив;
	Если Описание <> Неопределено Тогда
		Таблица = Описание.Получить("Table");
		Если Таблица <> Неопределено Тогда
			КлючСхема = Таблица.Получить("KeySchema");
			Если КлючСхема <> Неопределено Тогда
				Для Каждого Элемент Из КлючСхема Цикл
					Ключи.Добавить(Элемент.Получить("AttributeName"));
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Ключи;
КонецФункции

