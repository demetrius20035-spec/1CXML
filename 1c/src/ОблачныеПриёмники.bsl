#Область ТестыПодключений

// Проверяет подключение к ClickHouse (SELECT version()). Возвращает строку статуса
// либо вызывает исключение при ошибке.
Функция ПроверитьClickHouse(КонфигCH) Экспорт
	Тело = "SELECT version()";
	ТелоДД = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь);
	Хост = ХостИзURL(КонфигCH.Хост);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-ClickHouse-User", КонфигCH.Пользователь);
	Заголовки.Вставить("X-ClickHouse-Key", КонфигCH.Пароль);
	Заголовки.Вставить("Content-Type", "text/plain; charset=UTF-8");
	Запрос = Новый HTTPЗапрос("/", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоДД);
	Соединение = СоздатьСоединение(Хост, КонфигCH.Порт, КонфигCH.CACert);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ПроверитьОтвет(Ответ, "ClickHouse тест");
	Возврат "OK, ClickHouse: " + СокрЛП(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

// Проверяет доступность бакета Object Storage (GET ?max-keys=0, SigV4).
Функция ПроверитьS3(КонфигS3) Экспорт
	ХешПусто = HexНРег(SHA256Буфер(Новый БуферДвоичныхДанных(0)));
	Хост = ХостИзURL(КонфигS3.Endpoint);
	Путь = "/" + КодироватьПутьS3(КонфигS3.Бакет);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("host", Хост);
	Заголовки.Вставить("x-amz-content-sha256", ХешПусто);
	Авторизация = ПодписатьSigV4("GET", Хост, Путь, "max-keys=0", Заголовки, ХешПусто,
		"s3", КонфигS3.Регион, КонфигS3.AccessKey, КонфигS3.SecretKey);
	Запрос = СоздатьЗапрос(Путь + "?max-keys=0", Заголовки, Авторизация);
	Соединение = СоздатьСоединение(Хост, 443, КонфигS3.CACert);
	Ответ = Соединение.Получить(Запрос);
	ПроверитьОтвет(Ответ, "Object Storage тест");
	Возврат "OK, бакет доступен: " + КонфигS3.Бакет;
КонецФункции

// Проверяет подключение к YDB Document API (ListTables, SigV4 dynamodb).
Функция ПроверитьYDB(КонфигYDB) Экспорт
	Тело = "{}";
	ТелоДД = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь);
	ХешТела = HexНРег(SHA256Буфер(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ТелоДД)));
	Хост = ХостИзURL(КонфигYDB.DocApiEndpoint);
	Путь = ПутьИзURL(КонфигYDB.DocApiEndpoint);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("host", Хост);
	Заголовки.Вставить("x-amz-content-sha256", ХешТела);
	Заголовки.Вставить("x-amz-target", "DynamoDB_20120810.ListTables");
	Заголовки.Вставить("content-type", "application/x-amz-json-1.0");
	Авторизация = ПодписатьSigV4("POST", Хост, Путь, "", Заголовки, ХешТела,
		"dynamodb", КонфигYDB.Регион, КонфигYDB.AccessKey, КонфигYDB.SecretKey);
	Запрос = СоздатьЗапрос(Путь, Заголовки, Авторизация);
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоДД);
	Соединение = СоздатьСоединение(Хост, 443, КонфигYDB.CACert);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ПроверитьОтвет(Ответ, "YDB тест");
	Возврат "OK, YDB доступен. " + СокрЛП(Ответ.ПолучитьТелоКакСтроку());
КонецФункции

// Проверяет, существует ли таблица в ClickHouse (EXISTS TABLE).
Функция ТаблицаСуществуетВClickHouse(КонфигCH, ИмяТаблицы) Экспорт
	Тело = "EXISTS TABLE " + КонфигCH.База + "." + ИмяТаблицы;
	ТелоДД = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь);
	Хост = ХостИзURL(КонфигCH.Хост);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-ClickHouse-User", КонфигCH.Пользователь);
	Заголовки.Вставить("X-ClickHouse-Key", КонфигCH.Пароль);
	Запрос = Новый HTTPЗапрос("/", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоДД);
	Соединение = СоздатьСоединение(Хост, КонфигCH.Порт, КонфигCH.CACert);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ПроверитьОтвет(Ответ, "ClickHouse EXISTS");
	Возврат СокрЛП(Ответ.ПолучитьТелоКакСтроку()) = "1";
