////////////////////////////////////////////////////////////////////////////////
// Модуль «ОблачныеПриёмники»
//
// Назначение: прямая отправка данных из 1С в облако Yandex Cloud, минуя ручную
//             загрузку промежуточного файла:
//   * Yandex Object Storage (S3)  — архивирование и загрузка файлов выгрузки;
//   * YC Managed ClickHouse       — прямая вставка строк (HTTPS, JSONEachRow);
//   * YC Managed YDB (Document API, DynamoDB-совместимый) — BatchWriteItem.
//
// Используется обработкой «ВыгрузкаДанныхПоСхеме» как опциональные приёмники.
// Может быть оформлен как общий модуль конфигурации либо включён в модуль
// объекта обработки.
//
// ВАЖНО про YDB: относительные (реляционные) таблицы YDB наполняются только
// по gRPC (из 1С недоступно по HTTP). Здесь реализован путь через Document API
// (NoSQL document tables) — это легитимная прямая HTTP-загрузка из 1С. Для
// реляционных таблиц используйте путь S3 → импорт, либо Python-загрузчик.
//
// Все облачные вызовы выполняются по HTTPS. На сервере 1С должен быть установлен
// корневой сертификат Yandex (YandexInternalRootCA.crt) либо передан в настройках.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// --- Object Storage (S3) ---

// Загружает один файл в бакет Object Storage (path-style, SigV4).
Функция ОтправитьФайлВObjectStorage(КонфигS3, ПутьФайла, КлючОбъекта = "") Экспорт
	Файл = Новый Файл(ПутьФайла);
	Если НЕ ЗначениеЗаполнено(КлючОбъекта) Тогда
		КлючОбъекта = Файл.Имя;
	КонецЕсли;
	Если ЗначениеЗаполнено(КонфигS3.Префикс) Тогда
		КлючОбъекта = СтрЗаменить(КонфигS3.Префикс, "\", "/") + "/" + КлючОбъекта;
		КлючОбъекта = СтрЗаменить(КлючОбъекта, "//", "/");
	КонецЕсли;

	ТелоДД = Новый ДвоичныеДанные(ПутьФайла);
	ТелоБуфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ТелоДД);
	ХешТелаHex = HexНРег(SHA256Буфер(ТелоБуфер));

	Хост = ХостИзURL(КонфигS3.Endpoint);
	КаноническийПуть = "/" + КодироватьПутьS3(КонфигS3.Бакет) + "/" + КодироватьПутьS3(КлючОбъекта);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("host", Хост);
	Заголовки.Вставить("x-amz-content-sha256", ХешТелаHex);

	Авторизация = ПодписатьSigV4("PUT", Хост, КаноническийПуть, "", Заголовки, ХешТелаHex,
		"s3", КонфигS3.Регион, КонфигS3.AccessKey, КонфигS3.SecretKey);

	Запрос = СоздатьЗапрос(КаноническийПуть, Заголовки, Авторизация);
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоДД);
	Соединение = СоздатьСоединение(Хост, 443, КонфигS3.CACert);
	Ответ = Соединение.Записать(Запрос);
	ПроверитьОтвет(Ответ, "Object Storage PUT");
	Возврат КлючОбъекта;
КонецФункции

// Упаковывает список файлов в zip-архив.
Функция АрхивироватьФайлы(МассивПутей, ПутьАрхива) Экспорт
	Запись = Новый ЗаписьZipФайла(ПутьАрхива);
	Для Каждого Путь Из МассивПутей Цикл
		Запись.Добавить(Путь, РежимСохраненияПутейZIP.НеСохранятьПути);
	КонецЦикла;
	Запись.Записать();
	Возврат ПутьАрхива;
КонецФункции

// --- ClickHouse ---

// Вставляет пакет строк в таблицу ClickHouse (HTTPS, формат JSONEachRow).
// Раскладка — результат ПостроитьРаскладку(); МассивДанных — массив Соответствий
// (строки из .1cdata, ключ = имя поля 1С).
Процедура ОтправитьПакетВClickHouse(КонфигCH, ИмяТаблицы, Раскладка, МассивДанных) Экспорт
	Если МассивДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("INSERT INTO " + КонфигCH.База + "." + ИмяТаблицы + " FORMAT JSONEachRow");
	Для Каждого Данные Из МассивДанных Цикл
		Строки.Добавить(СериализоватьВСтроку(СтрокаВJSONОбъект(Данные, Раскладка)));
	КонецЦикла;
	Тело = СтрСоединить(Строки, Символы.ПС);
	ТелоДД = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь);

	Хост = ХостИзURL(КонфигCH.Хост);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-ClickHouse-User", КонфигCH.Пользователь);
	Заголовки.Вставить("X-ClickHouse-Key", КонфигCH.Пароль);
	Заголовки.Вставить("Content-Type", "text/plain; charset=UTF-8");

	Запрос = Новый HTTPЗапрос("/", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоДД);
	Соединение = СоздатьСоединение(Хост, КонфигCH.Порт, КонфигCH.CACert);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ПроверитьОтвет(Ответ, "ClickHouse INSERT");
КонецПроцедуры

// --- YDB (Document API, BatchWriteItem) ---

// Вставляет пакет (не более 25 строк!) в таблицу YDB Document API.
// КлючевыеИмена — массив имён ключевых атрибутов (для совместимости отбора).
Процедура ОтправитьПакетВYDB(КонфигYDB, ИмяТаблицы, Раскладка, МассивДанных) Экспорт
	Если МассивДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ЗапросыЗаписи = Новый Массив;
	Для Каждого Данные Из МассивДанных Цикл
		ПунктЗаписи = Новый Соответствие;
		ПунктЗаписи.Вставить("PutRequest", Новый Структура("Item", СтрокаВDynamoItem(Данные, Раскладка)));
		ЗапросыЗаписи.Добавить(ПунктЗаписи);
	КонецЦикла;
	ПоТаблицам = Новый Соответствие;
	ПоТаблицам.Вставить(ИмяТаблицы, ЗапросыЗаписи);
	ТелоСтруктура = Новый Соответствие;
	ТелоСтруктура.Вставить("RequestItems", ПоТаблицам);

	Тело = СериализоватьВСтроку(ТелоСтруктура);
	ТелоДД = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь);
	ХешТелаHex = HexНРег(SHA256Буфер(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ТелоДД)));

	Хост = ХостИзURL(КонфигYDB.DocApiEndpoint);
	Путь = ПутьИзURL(КонфигYDB.DocApiEndpoint);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("host", Хост);
	Заголовки.Вставить("x-amz-content-sha256", ХешТелаHex);
	Заголовки.Вставить("x-amz-target", "DynamoDB_20120810.BatchWriteItem");
	Заголовки.Вставить("content-type", "application/x-amz-json-1.0");

	Авторизация = ПодписатьSigV4("POST", Хост, Путь, "", Заголовки, ХешТелаHex,
		"dynamodb", КонфигYDB.Регион, КонфигYDB.AccessKey, КонфигYDB.SecretKey);

	Запрос = СоздатьЗапрос(Путь, Заголовки, Авторизация);
	Запрос.УстановитьТелоИзДвоичныхДанных(ТелоДД);
	Соединение = СоздатьСоединение(Хост, 443, КонфигYDB.CACert);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ПроверитьОтвет(Ответ, "YDB BatchWriteItem");
КонецПроцедуры

#КонецОбласти

#Область РаскладкаИПреобразованиеСтрок

// Строит SQL-раскладку колонок (аналог editor/rowmap + sqlgen).
// КолонкиСхемы — массив структур {Имя, Типы(массив дескрипторов), Спец}.
//   Спец: "" | "self_ref" | "line_number".
// Возвращает массив структур {ИмяSQL, Режим, Поле, ТипT}.
//   Режим: ref_id | ref_view | composite | scalar.
Функция ПостроитьРаскладку(КолонкиСхемы, Транслит = Истина) Экспорт
	Раскладка = Новый Массив;
	Для Каждого Колонка Из КолонкиСхемы Цикл
		Имя = Колонка.Имя;
		Типы = ?(Колонка.Свойство("Типы") И Колонка.Типы <> Неопределено, Колонка.Типы, Новый Массив);
		Спец = ?(Колонка.Свойство("Спец"), Колонка.Спец, "");
		ИмяSQL = БезопасноеИмяSQL(Имя, Транслит);

		Если Спец = "self_ref" Тогда
			ДобавитьСсылочнуюКолонку(Раскладка, Имя, ИмяSQL, Транслит);
		ИначеЕсли Спец = "line_number" Тогда
			Раскладка.Добавить(ЭлементРаскладки(ИмяSQL, "scalar", Имя, "Number"));
		ИначеЕсли Типы.Количество() > 1 Тогда
			Раскладка.Добавить(ЭлементРаскладки(ИмяSQL, "composite", Имя, "Composite"));
		ИначеЕсли Типы.Количество() = 1 И ЭтоСсылочныйТип(Типы[0]) Тогда
			ДобавитьСсылочнуюКолонку(Раскладка, Имя, ИмяSQL, Транслит);
		Иначе
			ТипT = ?(Типы.Количество() = 1, Типы[0].Получить("t"), "");
			Раскладка.Добавить(ЭлементРаскладки(ИмяSQL, "scalar", Имя, ТипT));
		КонецЕсли;
	КонецЦикла;
	Возврат Раскладка;
КонецФункции

Процедура ДобавитьСсылочнуюКолонку(Раскладка, Имя, ИмяSQL, Транслит)
	Раскладка.Добавить(ЭлементРаскладки(ИмяSQL, "ref_id", Имя, "UUID"));
	Раскладка.Добавить(ЭлементРаскладки(БезопасноеИмяSQL(Имя + "_view", Транслит), "ref_view", Имя, "String"));
КонецПроцедуры

Функция ЭлементРаскладки(ИмяSQL, Режим, Поле, ТипT)
	Возврат Новый Структура("ИмяSQL,Режим,Поле,ТипT", ИмяSQL, Режим, Поле, ТипT);
КонецФункции

Функция ЭтоСсылочныйТип(Дескриптор)
	т = Дескриптор.Получить("t");
	Возврат т = "Ref" Или т = "EnumRef";
КонецФункции

// Строит JSON-объект строки для ClickHouse (Соответствие имяКолонки -> значение).
Функция СтрокаВJSONОбъект(Данные, Раскладка) Экспорт
	Объект = Новый Соответствие;
	Для Каждого Эл Из Раскладка Цикл
		Значение = Данные.Получить(Эл.Поле);
		Объект.Вставить(Эл.ИмяSQL, ПреобразоватьЗначение(Значение, Эл));
	КонецЦикла;
	Возврат Объект;
КонецФункции

// Строит DynamoDB-Item для YDB Document API (типизированные атрибуты).
Функция СтрокаВDynamoItem(Данные, Раскладка) Экспорт
	Item = Новый Соответствие;
	Для Каждого Эл Из Раскладка Цикл
		Значение = ПреобразоватьЗначение(Данные.Получить(Эл.Поле), Эл);
		Если Значение = Неопределено Тогда
			Продолжить; // пропускаем NULL-атрибуты
		КонецЕсли;
		Атрибут = Новый Соответствие;
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Атрибут.Вставить("BOOL", Значение);
		ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
			Атрибут.Вставить("N", Формат(Значение, "ЧРД=.; ЧГ=0"));
		Иначе
			Атрибут.Вставить("S", Строка(Значение));
		КонецЕсли;
		Item.Вставить(Эл.ИмяSQL, Атрибут);
	КонецЦикла;
	Возврат Item;
КонецФункции

// Преобразует значение поля под режим колонки.
Функция ПреобразоватьЗначение(Значение, Эл)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Эл.Режим = "ref_id" Тогда
		Возврат ИзвлечьId(Значение);
	ИначеЕсли Эл.Режим = "ref_view" Тогда
		Возврат ИзвлечьПредставление(Значение);
	ИначеЕсли Эл.Режим = "composite" Тогда
		Возврат СериализоватьВСтроку(Значение);
	Иначе
		// scalar; для дат приводим к виду ClickHouse при необходимости
		Если Эл.ТипT = "Date" И ТипЗнч(Значение) = Тип("Строка") Тогда
			Возврат СтрЗаменить(СтрЗаменить(Значение, "T", " "), "Z", "");
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
КонецФункции

Функция ИзвлечьId(Значение)
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Значение.Получить("$ref");
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ИзвлечьПредставление(Значение)
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Значение.Получить("p");
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область ИменаSQL

Функция ИмяТаблицыSQL(ПолноеИмя, Транслит = Истина) Экспорт
	Возврат БезопасноеИмяSQL(СтрЗаменить(ПолноеИмя, ".", "_"), Транслит);
КонецФункции

Функция БезопасноеИмяSQL(Имя, Транслит = Истина) Экспорт
	Стр = ?(Транслит, Транслитерировать(Имя), Имя);
	Результат = "";
	Для Сч = 1 По СтрДлина(Стр) Цикл
		С = Сред(Стр, Сч, 1);
		Если ЭтоДопустимыйСимвол(С) Тогда
			Результат = Результат + С;
		Иначе
			Результат = Результат + "_";
		КонецЕсли;
	КонецЦикла;
	Если Результат = "" Тогда
		Результат = "col";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЭтоДопустимыйСимвол(С)
	Возврат (С >= "a" И С <= "z") Или (С >= "A" И С <= "Z")
		Или (С >= "0" И С <= "9") Или С = "_";
КонецФункции

Функция Транслитерировать(Текст) Экспорт
	Карта = КартаТранслита();
	Результат = "";
	Для Сч = 1 По СтрДлина(Текст) Цикл
		С = Сред(Текст, Сч, 1);
		Нижняя = НРег(С);
		Замена = Карта.Получить(Нижняя);
		Если Замена = Неопределено Тогда
			Результат = Результат + С;
		ИначеЕсли ЗначениеЗаполнено(Замена) И С = ВРег(С) И С <> Нижняя Тогда
			Результат = Результат + ВРег(Лев(Замена, 1)) + Сред(Замена, 2);
		Иначе
			Результат = Результат + Замена;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КартаТранслита()
	Карта = Новый Соответствие;
	Пары = "а=a,б=b,в=v,г=g,д=d,е=e,ё=e,ж=zh,з=z,и=i,й=y,к=k,л=l,м=m,н=n,о=o,"
		+ "п=p,р=r,с=s,т=t,у=u,ф=f,х=h,ц=c,ч=ch,ш=sh,щ=sch,ъ=,ы=y,ь=,э=e,ю=yu,я=ya";
	Для Каждого Пара Из СтрРазделить(Пары, ",") Цикл
		Позиция = СтрНайти(Пара, "=");
		Ключ = Лев(Пара, Позиция - 1);
		Значение = Сред(Пара, Позиция + 1);
		Карта.Вставить(Ключ, Значение);
	КонецЦикла;
	Возврат Карта;
КонецФункции

#КонецОбласти

#Область ПодписаниеSigV4

Функция ПодписатьSigV4(Метод, Хост, КаноническийПуть, КаноническийЗапрос, Заголовки,
	ХешТелаHex, Сервис, Регион, AccessKey, SecretKey)

	Сейчас = ТекущаяУниверсальнаяДата();
	ДатаШтамп = Формат(Сейчас, "ДФ=ггггММдд");
	AmzДата = ДатаШтамп + "T" + Формат(Сейчас, "ДФ=ЧЧммсс") + "Z";
	Заголовки.Вставить("x-amz-date", AmzДата);

	// канонические заголовки — отсортированы по имени (нижний регистр)
	Имена = Новый Массив;
	Для Каждого КЗ Из Заголовки Цикл
		Имена.Добавить(НРег(КЗ.Ключ));
	КонецЦикла;
	Имена.Сортировать();

	КаноническиеЗаголовки = "";
	ПодписанныеЗаголовки = "";
	НормЗаголовки = Новый Соответствие;
	Для Каждого КЗ Из Заголовки Цикл
		НормЗаголовки.Вставить(НРег(КЗ.Ключ), СокрЛП(КЗ.Значение));
	КонецЦикла;
	Для Каждого Имя Из Имена Цикл
		КаноническиеЗаголовки = КаноническиеЗаголовки + Имя + ":" + НормЗаголовки.Получить(Имя) + Символы.ПС;
		ПодписанныеЗаголовки = ПодписанныеЗаголовки + ?(ПодписанныеЗаголовки = "", "", ";") + Имя;
	КонецЦикла;

	КаноническийЗапросТекст = Метод + Символы.ПС + КаноническийПуть + Символы.ПС
		+ КаноническийЗапрос + Символы.ПС + КаноническиеЗаголовки + Символы.ПС
		+ ПодписанныеЗаголовки + Символы.ПС + ХешТелаHex;

	ХешЗапроса = HexНРег(SHA256Буфер(СтрокаВБуфер(КаноническийЗапросТекст)));
	Область = ДатаШтамп + "/" + Регион + "/" + Сервис + "/aws4_request";
	СтрокаДляПодписи = "AWS4-HMAC-SHA256" + Символы.ПС + AmzДата + Символы.ПС
		+ Область + Символы.ПС + ХешЗапроса;

	КлючПодписи = КлючПодписания(SecretKey, ДатаШтамп, Регион, Сервис);
	Подпись = HexНРег(HMAC256(КлючПодписи, СтрокаВБуфер(СтрокаДляПодписи)));

	Возврат "AWS4-HMAC-SHA256 Credential=" + AccessKey + "/" + Область
		+ ", SignedHeaders=" + ПодписанныеЗаголовки + ", Signature=" + Подпись;
КонецФункции

Функция КлючПодписания(SecretKey, ДатаШтамп, Регион, Сервис)
	кДата = HMAC256(СтрокаВБуфер("AWS4" + SecretKey), СтрокаВБуфер(ДатаШтамп));
	кРегион = HMAC256(кДата, СтрокаВБуфер(Регион));
	кСервис = HMAC256(кРегион, СтрокаВБуфер(Сервис));
	Возврат HMAC256(кСервис, СтрокаВБуфер("aws4_request"));
КонецФункции

#КонецОбласти

#Область Криптография

Функция SHA256Буфер(Буфер)
	ДД = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ДД);
	Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеш.ХешСумма);
КонецФункции

// HMAC-SHA256: реализован вручную (в платформе нет прямой функции HMAC).
Функция HMAC256(КлючБуфер, СообщениеБуфер)
	РазмерБлока = 64;
	Ключ = КлючБуфер;
	Если Ключ.Размер > РазмерБлока Тогда
		Ключ = SHA256Буфер(Ключ);
	КонецЕсли;
	КлючДополненный = Новый БуферДвоичныхДанных(РазмерБлока); // нули
	КлючДополненный.Записать(0, Ключ);

	ВнутрПад = Новый БуферДвоичныхДанных(РазмерБлока);
	ВнешПад = Новый БуферДвоичныхДанных(РазмерБлока);
	Для i = 0 По РазмерБлока - 1 Цикл
		Байт = КлючДополненный.Получить(i);
		ВнутрПад.Установить(i, ПобитовоеИсключительноеИли(Байт, 54));  // 0x36
		ВнешПад.Установить(i, ПобитовоеИсключительноеИли(Байт, 92));   // 0x5C
	КонецЦикла;

	ВнутрСообщ = Новый БуферДвоичныхДанных(РазмерБлока + СообщениеБуфер.Размер);
	ВнутрСообщ.Записать(0, ВнутрПад);
	ВнутрСообщ.Записать(РазмерБлока, СообщениеБуфер);
	ВнутрХеш = SHA256Буфер(ВнутрСообщ);

	ВнешСообщ = Новый БуферДвоичныхДанных(РазмерБлока + ВнутрХеш.Размер);
	ВнешСообщ.Записать(0, ВнешПад);
	ВнешСообщ.Записать(РазмерБлока, ВнутрХеш);
	Возврат SHA256Буфер(ВнешСообщ);
КонецФункции

Функция ПобитовоеИсключительноеИли(А, Б)
	// Побайтовый XOR (0..255) без зависимости от версии платформы.
	Результат = 0;
	Вес = 1;
	Для Разряд = 0 По 7 Цикл
		БитА = А % 2;
		БитБ = Б % 2;
		Если БитА <> БитБ Тогда
			Результат = Результат + Вес;
		КонецЕсли;
		А = Цел(А / 2);
		Б = Цел(Б / 2);
		Вес = Вес * 2;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтрокаВБуфер(Строка)
	ДД = ПолучитьДвоичныеДанныеИзСтроки(Строка, КодировкаТекста.UTF8, Ложь);
	Возврат ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДД);
КонецФункции

Функция HexНРег(Буфер)
	Возврат НРег(ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Буфер));
КонецФункции

