////////////////////////////////////////////////////////////////////////////////
// Модуль управляемой формы обработки «ВыгрузкаДанныхПоСхеме»
//
// Это код МОДУЛЯ ФОРМЫ. Сам файл формы бинарный — ниже инструкция по составу
// формы, затем готовый код обработчиков.
//
// ═════════════════════════════════════════════════════════════════════════════
// РЕКВИЗИТЫ ФОРМЫ (Форма → Реквизиты)
// ─────────────────────────────────────────────────────────────────────────────
// ОСНОВНОЕ:
//   ПутьСхемы            Строка    — путь к отредактированному .1cmeta
//   ПутьВыходной         Строка    — файл (single/volumes) или каталог (objects)
//   ДатаНачала           Дата      — отбор периода (начало)
//   ДатаОкончания        Дата      — отбор периода (конец)
//   Организация          *         — тип задаёт интегратор (напр. СправочникСсылка.
//                                     Организации). Можно не добавлять, если не нужно
//   Подразделение        *         — аналогично (СправочникСсылка.Подразделения)
//   РежимРазбиения       Строка    — single | objects | volumes | objects+volumes
//   МаксСтрокВТоме       Число     — порог тома (по умолчанию 100000)
//   ПорцияСервера        Число     — размер серверной порции (по умолчанию 10000)
//   Результат            Строка    — лог (МногострочныйРежим = Да, ТолькоПросмотр)
//
// ОБЛАКО — S3 (Yandex Object Storage):
//   S3Включить Булево; S3Архивировать Булево; S3Endpoint Строка; S3Регион Строка;
//   S3Бакет Строка; S3AccessKey Строка; S3SecretKey Строка(ПарольныйРежим);
//   S3Префикс Строка; S3CACert Строка
//
// ОБЛАКО — ClickHouse (YC Managed):
//   CHВключить Булево; CHХост Строка; CHПорт Число; CHБаза Строка;
//   CHПользователь Строка; CHПароль Строка(ПарольныйРежим); CHCACert Строка
//
// ОБЛАКО — YDB (YC Managed, Document API):
//   YDBВключить Булево; YDBDocApiEndpoint Строка; YDBРегион Строка;
//   YDBAccessKey Строка; YDBSecretKey Строка(ПарольныйРежим); YDBCACert Строка
//   РазмерПакетаClickHouse Число; РазмерПакетаYDB Число
//
// ═════════════════════════════════════════════════════════════════════════════
// ЭЛЕМЕНТЫ ФОРМЫ
//   * Группа «Страницы» с тремя страницами: «Основное», «Облако», «Журнал».
//   * Поля ввода ПутьСхемы и ПутьВыходной — КнопкаВыбора = Да; обработчики
//     ПутьСхемыНачалоВыбора / ПутьВыходнойНачалоВыбора.
//   * ПолеВвода РежимРазбиения — список выбора заполняется в ПриСозданииНаСервере.
//   * Поля ДатаНачала/ДатаОкончания, МаксСтрокВТоме, ПорцияСервера.
//   * Организация/Подразделение — поля ссылки (если реквизиты добавлены).
//   * На странице «Облако» три группы (S3 / ClickHouse / YDB) с флажком-включателем
//     и полями подключения. Поля *SecretKey / *Пароль — ПарольныйРежим = Да.
//   * На странице «Журнал» — поле Результат (растянуть).
//
// КОМАНДЫ ФОРМЫ → кнопки:
//   Выгрузить            → Выгрузить()            (ОсновныеДействия)
//   ОценитьОбъёмы        → ОценитьОбъёмы()        (страница «Основное») — статистика
//   СводкаСхемы          → СводкаСхемы()          (страница «Основное») — состав схемы
//   ПроверитьClickHouse  → ПроверитьClickHouse()  (группа ClickHouse)
//   ПроверитьS3          → ПроверитьS3()          (группа S3)
//   ПроверитьYDB         → ПроверитьYDB()         (группа YDB)
//   СверитьСхемуБД       → СверитьСхемуБД()        (страница «Облако») — сверка структуры
//                                                   целевых таблиц со схемой перед выгрузкой
//
// ПРОГРЕСС: для очень больших баз оберните вызов в фоновое задание
// (БиблиотекаСтандартныхПодсистем.ДлительныеОперации) и обновляйте индикатор.
// Здесь — синхронный вызов с индикацией через Состояние().
//
// ПУТЬ: в клиент-серверном варианте файлы создаются на СЕРВЕРЕ 1С — указывайте
// каталог, доступный серверу.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Список выбора для режима разбиения.
	СписокРежимов = Элементы.РежимРазбиения.СписокВыбора;
	СписокРежимов.Добавить("single", "Один файл");
	СписокРежимов.Добавить("objects", "Файл на объект");
	СписокРежимов.Добавить("volumes", "Многотомно");
	СписокРежимов.Добавить("objects+volumes", "Объекты + тома");

	Если НЕ ЗначениеЗаполнено(РежимРазбиения) Тогда
		РежимРазбиения = "single";
	КонецЕсли;
	Если МаксСтрокВТоме = 0 Тогда
		МаксСтрокВТоме = 100000;
	КонецЕсли;
	Если ПорцияСервера = 0 Тогда
		ПорцияСервера = 10000;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(S3Endpoint) Тогда
		S3Endpoint = "https://storage.yandexcloud.net";
		S3Регион = "ru-central1";
		S3Архивировать = Истина;
	КонецЕсли;
	Если CHПорт = 0 Тогда
		CHПорт = 8443;
	КонецЕсли;
	Если РазмерПакетаClickHouse = 0 Тогда
		РазмерПакетаClickHouse = 1000;
	КонецЕсли;
	Если РазмерПакетаYDB = 0 Тогда
		РазмерПакетаYDB = 25;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(YDBРегион) Тогда
		YDBРегион = "ru-central1";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ПутьСхемыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите схему .1cmeta";
	Диалог.Фильтр = "Схема 1С (*.1cmeta)|*.1cmeta|Все файлы (*.*)|*.*";
	Оповещение = Новый ОписаниеОповещения("ПутьСхемыВыборЗавершен", ЭтотОбъект);
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПутьСхемыВыборЗавершен(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		ПутьСхемы = ВыбранныеФайлы[0];
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыходнойНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Базовый файл выгрузки данных";
	Диалог.Расширение = "1cdata";
	Диалог.Фильтр = "Данные 1С (*.1cdata)|*.1cdata|Все файлы (*.*)|*.*";
	Оповещение = Новый ОписаниеОповещения("ПутьВыходнойВыборЗавершен", ЭтотОбъект);
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыходнойВыборЗавершен(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		ПутьВыходной = ВыбранныеФайлы[0];
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)
	Если НЕ ЗначениеЗаполнено(ПутьСхемы) Тогда
		ПоказатьПредупреждение(, "Укажите файл схемы .1cmeta.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПутьВыходной) Тогда
		ПоказатьПредупреждение(, "Укажите путь выгрузки данных.");
		Возврат;
	КонецЕсли;
	Состояние("Выгрузка данных по схеме…");
	Результат = ВыгрузитьНаСервере();
	Состояние();
КонецПроцедуры

&НаКлиенте
Процедура ОценитьОбъёмы(Команда)
	Если НЕ ЗначениеЗаполнено(ПутьСхемы) Тогда
		ПоказатьПредупреждение(, "Укажите файл схемы .1cmeta.");
		Возврат;
	КонецЕсли;
	Состояние("Подсчёт объёмов…");
	Результат = ОценитьОбъёмыНаСервере();
	Состояние();
КонецПроцедуры

&НаКлиенте
Процедура СводкаСхемы(Команда)
	Если НЕ ЗначениеЗаполнено(ПутьСхемы) Тогда
		ПоказатьПредупреждение(, "Укажите файл схемы .1cmeta.");
		Возврат;
	КонецЕсли;
	Результат = СводкаСхемыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьClickHouse(Команда)
	Состояние("Проверка ClickHouse…");
	Результат = ТестПодключенияНаСервере("clickhouse");
	Состояние();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьS3(Команда)
	Состояние("Проверка Object Storage…");
	Результат = ТестПодключенияНаСервере("s3");
	Состояние();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьYDB(Команда)
	Состояние("Проверка YDB…");
	Результат = ТестПодключенияНаСервере("ydb");
	Состояние();
КонецПроцедуры

&НаКлиенте
Процедура СверитьСхемуБД(Команда)
	Если НЕ ЗначениеЗаполнено(ПутьСхемы) Тогда
		ПоказатьПредупреждение(, "Укажите файл схемы .1cmeta.");
		Возврат;
	КонецЕсли;
	Состояние("Сверка структуры таблиц…");
	Результат = СверитьСхемуНаСервере();
	Состояние();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыгрузитьНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Параметры = ОбработкаОбъект.ПараметрыВыгрузкиПоУмолчанию();

	Параметры.ДатаНачала    = ДатаНачала;
	Параметры.ДатаОкончания = ДатаОкончания;
	Параметры.РежимРазбиения = РежимРазбиения;
	Параметры.МаксСтрокВТоме = МаксСтрокВТоме;
	Параметры.ПорцияСервера  = ПорцияСервера;

	// Организация/Подразделение — только если такие реквизиты добавлены на форму.
	Если Свойства().Получить("Организация") <> Неопределено Тогда
		Параметры.Организация = Организация;
	КонецЕсли;
	Если Свойства().Получить("Подразделение") <> Неопределено Тогда
		Параметры.Подразделение = Подразделение;
	КонецЕсли;

	ЗаполнитьОблако(Параметры.Облако);

	Попытка
		Итог = ОбработкаОбъект.ВыгрузитьДанные(ПутьСхемы, ПутьВыходной, Параметры);
	Исключение
		Возврат "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат СтрШаблон(
		"Готово. Строк: %1, объектов: %2, файлов: %3, томов: %4.",
		Итог.Строк, Итог.Объектов, Итог.Файлы.Количество(), Итог.Томов);
КонецФункции

&НаСервере
Процедура ЗаполнитьОблако(Облако)
	Облако.РазмерПакетаClickHouse = РазмерПакетаClickHouse;
	Облако.РазмерПакетаYDB = РазмерПакетаYDB;

	Облако.S3.Включить    = S3Включить;
	Облако.S3.Архивировать = S3Архивировать;
	Облако.S3.Endpoint    = S3Endpoint;
	Облако.S3.Регион      = S3Регион;
	Облако.S3.Бакет       = S3Бакет;
	Облако.S3.AccessKey   = S3AccessKey;
	Облако.S3.SecretKey   = S3SecretKey;
	Облако.S3.Префикс     = S3Префикс;
	Облако.S3.CACert      = S3CACert;

	Облако.ClickHouse.Включить    = CHВключить;
	Облако.ClickHouse.Хост        = CHХост;
	Облако.ClickHouse.Порт        = CHПорт;
	Облако.ClickHouse.База         = CHБаза;
	Облако.ClickHouse.Пользователь = CHПользователь;
	Облако.ClickHouse.Пароль       = CHПароль;
	Облако.ClickHouse.CACert       = CHCACert;

	Облако.YDB.Включить       = YDBВключить;
	Облако.YDB.DocApiEndpoint = YDBDocApiEndpoint;
	Облако.YDB.Регион         = YDBРегион;
	Облако.YDB.AccessKey      = YDBAccessKey;
	Облако.YDB.SecretKey      = YDBSecretKey;
	Облако.YDB.CACert         = YDBCACert;
КонецПроцедуры

// Имена реквизитов формы (для безопасной проверки наличия Организация/Подразделение).
&НаСервере
Функция Свойства()
	Карта = Новый Соответствие;
	Для Каждого Реквизит Из ПолучитьРеквизиты() Цикл
		Карта.Вставить(Реквизит.Имя, Истина);
	КонецЦикла;
	Возврат Карта;
КонецФункции

&НаСервере
Функция ПолучитьОблако()
	Облако = РеквизитФормыВЗначение("Объект").ПараметрыОблакаПоУмолчанию();
	ЗаполнитьОблако(Облако);
	Возврат Облако;
КонецФункции

&НаСервере
Функция ТестПодключенияНаСервере(Вид)
	Облако = ПолучитьОблако();
	Попытка
		Если Вид = "clickhouse" Тогда
			Возврат ОблачныеПриёмники.ПроверитьClickHouse(Облако.ClickHouse);
		ИначеЕсли Вид = "s3" Тогда
			Возврат ОблачныеПриёмники.ПроверитьS3(Облако.S3);
		Иначе
			Возврат ОблачныеПриёмники.ПроверитьYDB(Облако.YDB);
		КонецЕсли;
	Исключение
		Возврат "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаСервере
Функция СверитьСхемуНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Параметры = ОбработкаОбъект.ПараметрыВыгрузкиПоУмолчанию();
	ЗаполнитьОблако(Параметры.Облако);
	Если НЕ (Параметры.Облако.ClickHouse.Включить Или Параметры.Облако.YDB.Включить) Тогда
		Возврат "Сверка доступна для включённых приёмников ClickHouse/YDB. "
			+ "MariaDB из 1С не сверяется — создавайте/проверяйте таблицы в редакторе.";
	КонецЕсли;
	Попытка
		Сверка = ОбработкаОбъект.СверитьСхему(ПутьСхемы, Параметры);
	Исключение
		Возврат "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;
	Строки = Новый Массив;
	Если Сверка.Проблемы.Количество() > 0 Тогда
		Строки.Добавить("Ошибки структуры (" + Сверка.Проблемы.Количество() + "):");
		Для Каждого Проблема Из Сверка.Проблемы Цикл
			Строки.Добавить("  ✖ " + Проблема);
		КонецЦикла;
	КонецЕсли;
	Если Сверка.Свойство("Предупреждения") И Сверка.Предупреждения.Количество() > 0 Тогда
		Строки.Добавить("Предупреждения по типам (" + Сверка.Предупреждения.Количество() + "):");
		Для Каждого Предупреждение Из Сверка.Предупреждения Цикл
			Строки.Добавить("  ⚠ " + Предупреждение);
		КонецЦикла;
	КонецЕсли;
	Если Строки.Количество() = 0 Тогда
		Возврат "OK. Структура целевых таблиц соответствует схеме.";
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

&НаСервере
Функция ОценитьОбъёмыНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Параметры = ОбработкаОбъект.ПараметрыВыгрузкиПоУмолчанию();
	Параметры.ДатаНачала = ДатаНачала;
	Параметры.ДатаОкончания = ДатаОкончания;
	Если Свойства().Получить("Организация") <> Неопределено Тогда
		Параметры.Организация = Организация;
	КонецЕсли;
	Если Свойства().Получить("Подразделение") <> Неопределено Тогда
		Параметры.Подразделение = Подразделение;
	КонецЕсли;

	Попытка
		Оценка = ОбработкаОбъект.ОценитьОбъёмы(ПутьСхемы, Параметры);
	Исключение
		Возврат "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Строки = Новый Массив;
	Строки.Добавить("Оценка объёмов (записей):");
	Для Каждого Стр Из Оценка.Строки Цикл
		Кол = ?(Стр.Количество < 0, "н/д", Формат(Стр.Количество, "ЧГ=0"));
		Строки.Добавить("  " + Стр.ПолноеИмя + ": " + Кол);
	КонецЦикла;
	Строки.Добавить("Итого: " + Формат(Оценка.Итого, "ЧГ=0"));
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

&НаСервере
Функция СводкаСхемыНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Попытка
		Сводка = ОбработкаОбъект.СводкаСхемы(ПутьСхемы);
	Исключение
		Возврат "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Объектов: %1, полей: %2, табличных частей: %3",
		Сводка.Объектов, Сводка.Полей, Сводка.ТабличныхЧастей));
	Строки.Добавить("По видам:");
	Для Каждого КЗ Из Сводка.ПоВидам Цикл
		Строки.Добавить("  " + КЗ.Ключ + ": " + КЗ.Значение);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

#КонецОбласти
