////////////////////////////////////////////////////////////////////////////////
// Модуль управляемой формы обработки «ВыгрузкаСтруктурыМетаданных»
//
// Это код МОДУЛЯ ФОРМЫ. Сам файл формы бинарный, поэтому ниже — инструкция,
// что положить на форму, и далее — готовый код обработчиков.
//
// ┌─────────────────────────────────────────────────────────────────────────┐
// │ РЕКВИЗИТЫ ФОРМЫ (Форма → Реквизиты)                                        │
// ├───────────────────────────────┬───────────┬───────────────────────────────┤
// │ Имя                           │ Тип       │ Назначение                    │
// ├───────────────────────────────┼───────────┼───────────────────────────────┤
// │ ПутьКФайлу                    │ Строка    │ Путь к создаваемому .1cmeta   │
// │ ВыгружатьОтчетыОбработки       │ Булево    │ Включать Отчёты/Обработки     │
// │ ВыгружатьКоманды               │ Булево    │ Выгружать узлы команд         │
// │ ТолькоОбъектыСДанными          │ Булево    │ Пропускать объекты без данных │
// │ Результат                     │ Строка    │ Лог (МногострочныйРежим=Да)   │
// └───────────────────────────────┴───────────┴───────────────────────────────┘
//
// ЭЛЕМЕНТЫ ФОРМЫ (перетащить реквизиты на форму):
//   * Поле ввода «ПутьКФайлу» (КнопкаВыбора = Да; ОбработкаВыбора → ПутьКФайлуНачалоВыбора).
//   * Флажки: ВыгружатьОтчетыОбработки, ВыгружатьКоманды, ТолькоОбъектыСДанными.
//   * Поле «Результат» — вид «Поле текстового документа» либо МногострочноеПоле,
//     ТолькоПросмотр = Да, растянуть.
//
// КОМАНДЫ ФОРМЫ (Форма → Команды), вынести как кнопки в командную панель:
//   * Выгрузить  → обработчик Выгрузить()      (Кнопка, ОсновныеДействия)
//
// ВАЖНО про путь: в клиент-серверном варианте файл создаётся на СЕРВЕРЕ 1С —
// указывайте каталог, доступный серверу. В файловой базе/толстом клиенте это
// та же машина. Для тонкого клиента без доступа к ФС сервера используйте режим
// «скачать» (см. комментарий в ВыгрузитьНаСервере).
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ПутьКФайлу = "C:\temp\" + Метаданные.Имя + ".1cmeta";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Куда сохранить структуру метаданных";
	Диалог.Расширение = "1cmeta";
	Диалог.Фильтр = "Схема 1С (*.1cmeta)|*.1cmeta|Все файлы (*.*)|*.*";
	Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Диалог.ПолноеИмяФайла = ПутьКФайлу;
	КонецЕсли;
	ОписаниеОповещения = Новый ОписаниеОповещения("ПутьКФайлуВыборЗавершен", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуВыборЗавершен(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		ПутьКФайлу = ВыбранныеФайлы[0];
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ПоказатьПредупреждение(, "Укажите путь к файлу.");
		Возврат;
	КонецЕсли;
	Состояние("Выгрузка структуры метаданных…");
	Результат = ВыгрузитьНаСервере();
	Состояние();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыгрузитьНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Параметры = Новый Структура;
	Параметры.Вставить("ВыгружатьОтчетыОбработки", ВыгружатьОтчетыОбработки);
	Параметры.Вставить("ВыгружатьКоманды", ВыгружатьКоманды);
	Параметры.Вставить("ТолькоОбъектыСДанными", ТолькоОбъектыСДанными);

	Попытка
		Итог = ОбработкаОбъект.ВыгрузитьСтруктуруВФайл(ПутьКФайлу, Параметры);
	Исключение
		Возврат "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	// Тонкий клиент без доступа к ФС сервера: при необходимости можно вернуть файл
	// для скачивания. Раскомментируйте и добавьте на форму обработку получения:
	//   ДД = Новый ДвоичныеДанные(ПутьКФайлу);
	//   АдресХранилища = ПоместитьВоВременноеХранилище(ДД, УникальныйИдентификатор);
	//   ... затем на клиенте ПолучитьФайл(АдресХранилища, ИмяФайла);

	Возврат СтрШаблон("Готово. Узлов: %1, объектов: %2.%3Файл: %4",
		Итог.КоличествоУзлов, Итог.КоличествоОбъектов, Символы.ПС, ПутьКФайлу);
КонецФункции

#КонецОбласти
