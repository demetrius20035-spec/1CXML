////////////////////////////////////////////////////////////////////////////////
// Обработка «ВыгрузкаСтруктурыМетаданных»
//
// Назначение: выгрузка структуры метаданных ЛЮБОЙ конфигурации 1С в файл
//             формата .1cmeta (NDJSON). См. docs/FORMAT.md.
//
// Это модуль объекта внешней обработки. Содержит экспортные методы как для
// интерактивного запуска (с формы), так и для программного вызова из кода
// конфигурации, в которую обработка встроена/подключена.
//
// Точки входа:
//   ВыгрузитьСтруктуруВФайл(ПутьКФайлу, Параметры = Неопределено) Экспорт
//
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Выгружает полную структуру метаданных текущей конфигурации в файл NDJSON.
//
// Параметры:
//   ПутьКФайлу - Строка - полный путь к создаваемому файлу .1cmeta.
//   Параметры  - Структура, Неопределено - тонкая настройка состава выгрузки:
//       * ВыгружатьОтчетыОбработки - Булево - включать ли Отчёты/Обработки
//                                    (в них нет данных, но структура полезна).
//                                    По умолчанию Ложь.
//       * ВыгружатьКоманды         - Булево - выгружать узлы команд. По умолч. Ложь.
//       * ТолькоОбъектыСДанными    - Булево - пропускать узлы без данных. По умолч. Ложь.
//
// Возвращаемое значение:
//   Структура - статистика: КоличествоУзлов, КоличествоОбъектов.
//
Функция ВыгрузитьСтруктуруВФайл(ПутьКФайлу, Параметры = Неопределено) Экспорт

	Настройки = НастройкиПоУмолчанию();
	Если Параметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Настройки, Параметры);
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("Файл", Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8));
	Контекст.Вставить("СледующийId", 1);
	Контекст.Вставить("КоличествоУзлов", 0);
	Контекст.Вставить("КоличествоОбъектов", 0);
	Контекст.Вставить("Настройки", Настройки);

	Попытка
		ЗаписатьЗаголовок(Контекст);
		КореньId = ДобавитьУзел(Контекст, 0, "ConfigRoot", Метаданные.Имя,
			НовыеПоля("synonym", Метаданные.Синоним, "fullName", "Конфигурация"));

		ВыгрузитьКлассыМетаданных(Контекст, КореньId);

		ЗаписатьЗавершение(Контекст);
	Исключение
		Контекст.Файл.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Контекст.Файл.Закрыть();

	Результат = Новый Структура;
	Результат.Вставить("КоличествоУзлов", Контекст.КоличествоУзлов);
	Результат.Вставить("КоличествоОбъектов", Контекст.КоличествоОбъектов);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

Функция НастройкиПоУмолчанию()
	Настройки = Новый Структура;
	Настройки.Вставить("ВыгружатьОтчетыОбработки", Ложь);
	Настройки.Вставить("ВыгружатьКоманды", Ложь);
	Настройки.Вставить("ТолькоОбъектыСДанными", Ложь);
	Возврат Настройки;
КонецФункции

Процедура ЗаписатьЗаголовок(Контекст)
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Заголовок = Новый Соответствие;
	Заголовок.Вставить("$", "header");
	Заголовок.Вставить("format", "1cmeta-ndjson");
	Заголовок.Вставить("version", 1);
	Заголовок.Вставить("config", Метаданные.Имя);
	Заголовок.Вставить("configSynonym", Метаданные.Синоним);
	Заголовок.Вставить("configVersion", Метаданные.Версия);
	Заголовок.Вставить("vendor", Метаданные.Поставщик);
	Заголовок.Вставить("platform", СистемнаяИнформация.ВерсияПриложения);
	Заголовок.Вставить("generated", ДатаВСтрокеISO(ТекущаяДата()));
	Контекст.Файл.ЗаписатьСтроку(СериализоватьВСтроку(Заголовок));
КонецПроцедуры

Процедура ЗаписатьЗавершение(Контекст)
	Подвал = Новый Соответствие;
	Подвал.Вставить("$", "footer");
	Подвал.Вставить("nodes", Контекст.КоличествоУзлов);
	Подвал.Вставить("objects", Контекст.КоличествоОбъектов);
	Контекст.Файл.ЗаписатьСтроку(СериализоватьВСтроку(Подвал));
КонецПроцедуры

// Обходит все классы прикладных объектов конфигурации.
Процедура ВыгрузитьКлассыМетаданных(Контекст, КореньId)

	// Описание классов: Коллекция метаданных, вид узла объекта, имя класса.
	Классы = Новый Массив;
	Классы.Добавить(ОписаниеКласса(Метаданные.Константы, "Constant", "Константы", "Поля"));
	Классы.Добавить(ОписаниеКласса(Метаданные.Справочники, "Catalog", "Справочники", "Объект"));
	Классы.Добавить(ОписаниеКласса(Метаданные.Документы, "Document", "Документы", "Объект"));
	Классы.Добавить(ОписаниеКласса(Метаданные.ЖурналыДокументов, "DocumentJournal", "ЖурналыДокументов", "Журнал"));
	Классы.Добавить(ОписаниеКласса(Метаданные.Перечисления, "Enum", "Перечисления", "Перечисление"));
	Классы.Добавить(ОписаниеКласса(Метаданные.ПланыВидовХарактеристик, "ChartOfCharacteristicTypes", "ПланыВидовХарактеристик", "Объект"));
	Классы.Добавить(ОписаниеКласса(Метаданные.ПланыСчетов, "ChartOfAccounts", "ПланыСчетов", "ПланСчетов"));
	Классы.Добавить(ОписаниеКласса(Метаданные.ПланыВидовРасчета, "ChartOfCalculationTypes", "ПланыВидовРасчета", "Объект"));
	Классы.Добавить(ОписаниеКласса(Метаданные.РегистрыСведений, "InformationRegister", "РегистрыСведений", "Регистр"));
	Классы.Добавить(ОписаниеКласса(Метаданные.РегистрыНакопления, "AccumulationRegister", "РегистрыНакопления", "Регистр"));
	Классы.Добавить(ОписаниеКласса(Метаданные.РегистрыБухгалтерии, "AccountingRegister", "РегистрыБухгалтерии", "Регистр"));
	Классы.Добавить(ОписаниеКласса(Метаданные.РегистрыРасчета, "CalculationRegister", "РегистрыРасчета", "Регистр"));
	Классы.Добавить(ОписаниеКласса(Метаданные.БизнесПроцессы, "BusinessProcess", "БизнесПроцессы", "Объект"));
	Классы.Добавить(ОписаниеКласса(Метаданные.Задачи, "Task", "Задачи", "Объект"));
	Классы.Добавить(ОписаниеКласса(Метаданные.ПланыОбмена, "ExchangePlan", "ПланыОбмена", "Объект"));

	Если Контекст.Настройки.ВыгружатьОтчетыОбработки Тогда
		Классы.Добавить(ОписаниеКласса(Метаданные.Отчеты, "Report", "Отчеты", "Объект"));
		Классы.Добавить(ОписаниеКласса(Метаданные.Обработки, "DataProcessor", "Обработки", "Объект"));
	КонецЕсли;

	Для Каждого ОписаниеК Из Классы Цикл
		КлассId = ДобавитьУзел(Контекст, КореньId, "MetadataClass", ОписаниеК.Имя, Неопределено);
		Для Каждого ОбъектМД Из ОписаниеК.Коллекция Цикл
			ВыгрузитьОбъект(Контекст, КлассId, ОбъектМД, ОписаниеК.Вид, ОписаниеК.Профиль);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеКласса(Коллекция, Вид, Имя, Профиль)
	Стр = Новый Структура;
	Стр.Вставить("Коллекция", Коллекция);
	Стр.Вставить("Вид", Вид);
	Стр.Вставить("Имя", Имя);
	Стр.Вставить("Профиль", Профиль); // Объект | Регистр | Перечисление | Поля | Журнал | ПланСчетов
	Возврат Стр;
КонецФункции

// Выгружает один прикладной объект метаданных вместе с его полями.
Процедура ВыгрузитьОбъект(Контекст, КлассId, ОбъектМД, Вид, Профиль)

	ДопПоля = Новый Соответствие;
	ДопПоля.Вставить("synonym", ОбъектМД.Синоним);
	ДопПоля.Вставить("fullName", ОбъектМД.ПолноеИмя());
	Если ЗначениеЗаполнено(ОбъектМД.Комментарий) Тогда
		ДопПоля.Вставить("comment", ОбъектМД.Комментарий);
	КонецЕсли;
	ДобавитьСвойстваОбъекта(ДопПоля, ОбъектМД, Вид);

	ОбъектId = ДобавитьУзел(Контекст, КлассId, Вид, ОбъектМД.Имя, ДопПоля);
	Контекст.КоличествоОбъектов = Контекст.КоличествоОбъектов + 1;

	Если Профиль = "Поля" Тогда
		// Константа: единственный «реквизит» — тип самой константы.
		ДобавитьПоле(Контекст, ОбъектId, "Attribute", "Значение", ОбъектМД.Тип, ОбъектМД.Синоним);

	ИначеЕсли Профиль = "Объект" Тогда
		ВыгрузитьСтандартныеРеквизиты(Контекст, ОбъектId, ОбъектМД);
		ВыгрузитьРеквизиты(Контекст, ОбъектId, ОбъектМД.Реквизиты);
		ВыгрузитьТабличныеЧасти(Контекст, ОбъектId, ОбъектМД);

	ИначеЕсли Профиль = "ПланСчетов" Тогда
		ВыгрузитьСтандартныеРеквизиты(Контекст, ОбъектId, ОбъектМД);
		ВыгрузитьРеквизиты(Контекст, ОбъектId, ОбъектМД.Реквизиты);
		ВыгрузитьПризнакиУчета(Контекст, ОбъектId, ОбъектМД);
		ВыгрузитьТабличныеЧасти(Контекст, ОбъектId, ОбъектМД);

	ИначеЕсли Профиль = "Регистр" Тогда
		ВыгрузитьСтандартныеРеквизиты(Контекст, ОбъектId, ОбъектМД);
		ВыгрузитьИзмеренияРесурсы(Контекст, ОбъектId, ОбъектМД);
		ВыгрузитьРеквизиты(Контекст, ОбъектId, ОбъектМД.Реквизиты);

	ИначеЕсли Профиль = "Перечисление" Тогда
		Для Каждого Значение Из ОбъектМД.ЗначенияПеречисления Цикл
			ДопПоляЗнач = Новый Соответствие;
			ДопПоляЗнач.Вставить("synonym", Значение.Синоним);
			ДобавитьУзел(Контекст, ОбъектId, "EnumValue", Значение.Имя, ДопПоляЗнач);
		КонецЦикла;

	ИначеЕсли Профиль = "Журнал" Тогда
		ВыгрузитьСтандартныеРеквизиты(Контекст, ОбъектId, ОбъектМД);
		Для Каждого Граф Из ОбъектМД.Графы Цикл
			ДопПоляГ = Новый Соответствие;
			ДопПоляГ.Вставить("synonym", Граф.Синоним);
			ДобавитьУзел(Контекст, ОбъектId, "Attribute", Граф.Имя, ДопПоляГ);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьСвойстваОбъекта(ДопПоля, ОбъектМД, Вид)
	Свойства = Новый Соответствие;
	Если Вид = "Catalog" Тогда
		Свойства.Вставить("hierarchical", ОбъектМД.Иерархический);
		Если ОбъектМД.Иерархический Тогда
			Свойства.Вставить("hierarchyType", Строка(ОбъектМД.ВидИерархии));
		КонецЕсли;
	ИначеЕсли Вид = "InformationRegister" Тогда
		Свойства.Вставить("periodicity", Строка(ОбъектМД.Периодичность));
		Свойства.Вставить("writeMode", Строка(ОбъектМД.РежимЗаписи));
	ИначеЕсли Вид = "AccumulationRegister" Тогда
		Свойства.Вставить("registerType", Строка(ОбъектМД.ВидРегистра));
	КонецЕсли;
	Если Свойства.Количество() > 0 Тогда
		ДопПоля.Вставить("props", Свойства);
	КонецЕсли;
КонецПроцедуры

Процедура ВыгрузитьСтандартныеРеквизиты(Контекст, РодительId, ОбъектМД)
	Попытка
		Коллекция = ОбъектМД.СтандартныеРеквизиты;
	Исключение
		Возврат; // не у всех объектов есть СтандартныеРеквизиты
	КонецПопытки;
	Для Каждого Реквизит Из Коллекция Цикл
		ДобавитьПоле(Контекст, РодительId, "StandardAttribute", Реквизит.Имя, Реквизит.Тип, Реквизит.Синоним);
	КонецЦикла;
КонецПроцедуры

Процедура ВыгрузитьРеквизиты(Контекст, РодительId, Коллекция)
	Для Каждого Реквизит Из Коллекция Цикл
		ДобавитьПоле(Контекст, РодительId, "Attribute", Реквизит.Имя, Реквизит.Тип, Реквизит.Синоним, Реквизит.Комментарий);
	КонецЦикла;
КонецПроцедуры

Процедура ВыгрузитьТабличныеЧасти(Контекст, ОбъектId, ОбъектМД)
	Попытка
		Коллекция = ОбъектМД.ТабличныеЧасти;
	Исключение
		Возврат;
	КонецПопытки;
	Для Каждого ТЧ Из Коллекция Цикл
		ДопПоля = Новый Соответствие;
		ДопПоля.Вставить("synonym", ТЧ.Синоним);
		ТЧId = ДобавитьУзел(Контекст, ОбъектId, "TabularSection", ТЧ.Имя, ДопПоля);
		ВыгрузитьСтандартныеРеквизиты(Контекст, ТЧId, ТЧ);
		ВыгрузитьРеквизиты(Контекст, ТЧId, ТЧ.Реквизиты);
	КонецЦикла;
КонецПроцедуры

Процедура ВыгрузитьИзмеренияРесурсы(Контекст, РодительId, РегистрМД)
	Для Каждого Измерение Из РегистрМД.Измерения Цикл
		ДобавитьПоле(Контекст, РодительId, "Dimension", Измерение.Имя, Измерение.Тип, Измерение.Синоним);
	КонецЦикла;
	Для Каждого Ресурс Из РегистрМД.Ресурсы Цикл
		ДобавитьПоле(Контекст, РодительId, "Resource", Ресурс.Имя, Ресурс.Тип, Ресурс.Синоним);
	КонецЦикла;
КонецПроцедуры

Процедура ВыгрузитьПризнакиУчета(Контекст, ОбъектId, ОбъектМД)
	Попытка
		Признаки = ОбъектМД.ПризнакиУчета;
	Исключение
		Возврат;
	КонецПопытки;
	Для Каждого Признак Из Признаки Цикл
		ДобавитьПоле(Контекст, ОбъектId, "AccountingFlag", Признак.Имя, Признак.Тип, Признак.Синоним);
	КонецЦикла;
	Попытка
		ПризнакиСубконто = ОбъектМД.ПризнакиУчетаСубконто;
	Исключение
		Возврат;
	КонецПопытки;
	Для Каждого Признак Из ПризнакиСубконто Цикл
		ДобавитьПоле(Контекст, ОбъектId, "ExtDimensionAccountingFlag", Признак.Имя, Признак.Тип, Признак.Синоним);
	КонецЦикла;
КонецПроцедуры

// Создаёт узел-поле с описанием типа.
Процедура ДобавитьПоле(Контекст, РодительId, Вид, Имя, ОписаниеТипов, Синоним = "", Комментарий = "")
	ДопПоля = Новый Соответствие;
	Если ЗначениеЗаполнено(Синоним) Тогда
		ДопПоля.Вставить("synonym", Синоним);
	КонецЕсли;
	Если ЗначениеЗаполнено(Комментарий) Тогда
		ДопПоля.Вставить("comment", Комментарий);
	КонецЕсли;
	ОписаниеТипа = РазобратьОписаниеТипов(ОписаниеТипов);
	ДопПоля.Вставить("types", ОписаниеТипа.Типы);
	Если ОписаниеТипа.Составной Тогда
		ДопПоля.Вставить("composite", Истина);
	КонецЕсли;
	ДобавитьУзел(Контекст, РодительId, Вид, Имя, ДопПоля);
КонецПроцедуры

// Преобразует ОписаниеТипов в массив дескрипторов (см. docs/FORMAT.md §5).
Функция РазобратьОписаниеТипов(ОписаниеТипов)
	Типы = Новый Массив;
	Если ОписаниеТипов <> Неопределено Тогда
		Для Каждого Т Из ОписаниеТипов.Типы() Цикл
			Типы.Добавить(ДескрипторТипа(Т, ОписаниеТипов));
		КонецЦикла;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Типы", Типы);
	Результат.Вставить("Составной", Типы.Количество() > 1);
	Возврат Результат;
КонецФункции

Функция ДескрипторТипа(Т, ОписаниеТипов)
	Д = Новый Соответствие;

	Если Т = Тип("Строка") Тогда
		Кв = ОписаниеТипов.КвалификаторыСтроки;
		Д.Вставить("t", "String");
		Д.Вставить("len", Кв.Длина);
		Д.Вставить("allowedLength", ?(Кв.ДопустимаяДлина = ДопустимаяДлина.Фиксированная, "Fixed", "Variable"));

	ИначеЕсли Т = Тип("Число") Тогда
		Кв = ОписаниеТипов.КвалификаторыЧисла;
		Д.Вставить("t", "Number");
		Д.Вставить("digits", Кв.Разрядность);
		Д.Вставить("fraction", Кв.РазрядностьДробнойЧасти);
		Д.Вставить("nonNegative", Кв.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный);

	ИначеЕсли Т = Тип("Дата") Тогда
		Кв = ОписаниеТипов.КвалификаторыДаты;
		ЧастиД = "DateTime";
		Если Кв.ЧастиДаты = ЧастиДаты.Дата Тогда
			ЧастиД = "Date";
		ИначеЕсли Кв.ЧастиДаты = ЧастиДаты.Время Тогда
			ЧастиД = "Time";
		КонецЕсли;
		Д.Вставить("t", "Date");
		Д.Вставить("dateParts", ЧастиД);

	ИначеЕсли Т = Тип("Булево") Тогда
		Д.Вставить("t", "Boolean");
	ИначеЕсли Т = Тип("ХранилищеЗначения") Тогда
		Д.Вставить("t", "ValueStorage");
	ИначеЕсли Т = Тип("УникальныйИдентификатор") Тогда
		Д.Вставить("t", "UUID");
	ИначеЕсли Т = Тип("Тип") Тогда
		Д.Вставить("t", "Type");
	Иначе
		ОбъектМД = Метаданные.НайтиПоТипу(Т);
		Если ОбъектМД <> Неопределено Тогда
			ПолноеИмя = ОбъектМД.ПолноеИмя();
			Если Лев(ПолноеИмя, 13) = "Перечисление." Тогда
				Д.Вставить("t", "EnumRef");
			Иначе
				Д.Вставить("t", "Ref");
			КонецЕсли;
			Д.Вставить("meta", ПолноеИмя);
		Иначе
			Д.Вставить("t", "Unknown");
			Д.Вставить("raw", Строка(Т));
		КонецЕсли;
	КонецЕсли;

	Возврат Д;
КонецФункции

// Записывает узел в файл и возвращает его id.
Функция ДобавитьУзел(Контекст, Родитель, Вид, Имя, ДопПоля)
	Ид = Контекст.СледующийId;
	Контекст.СледующийId = Ид + 1;

	Узел = Новый Соответствие;
	Узел.Вставить("$", "node");
	Узел.Вставить("id", Ид);
	Узел.Вставить("parent", Родитель);
	Узел.Вставить("kind", Вид);
	Узел.Вставить("name", Имя);

	ЕстьSel = Ложь;
	Если ДопПоля <> Неопределено Тогда
		Для Каждого КЗ Из ДопПоля Цикл
			Узел.Вставить(КЗ.Ключ, КЗ.Значение);
			Если КЗ.Ключ = "sel" Тогда
				ЕстьSel = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если НЕ ЕстьSel Тогда
		Узел.Вставить("sel", Истина);
	КонецЕсли;

	Контекст.Файл.ЗаписатьСтроку(СериализоватьВСтроку(Узел));
	Контекст.КоличествоУзлов = Контекст.КоличествоУзлов + 1;
	Возврат Ид;
КонецФункции

Функция НовыеПоля(Ключ1 = Неопределено, Знач1 = Неопределено, Ключ2 = Неопределено, Знач2 = Неопределено)
	Поля = Новый Соответствие;
	Если Ключ1 <> Неопределено Тогда
		Поля.Вставить(Ключ1, Знач1);
	КонецЕсли;
	Если Ключ2 <> Неопределено Тогда
		Поля.Вставить(Ключ2, Знач2);
	КонецЕсли;
	Возврат Поля;
КонецФункции

// Сериализует значение в одну строку JSON (без переносов — валидный NDJSON).
Функция СериализоватьВСтроку(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ДатаВСтрокеISO(Дата)
	Возврат XMLСтрока(Дата);
КонецФункции

#КонецОбласти
