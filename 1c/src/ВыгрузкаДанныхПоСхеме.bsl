////////////////////////////////////////////////////////////////////////////////
// Обработка «ВыгрузкаДанныхПоСхеме»
//
// Назначение: универсальная (для любой конфигурации) выгрузка данных согласно
//             отредактированной схеме .1cmeta. См. docs/FORMAT.md §7.
//
// Ключевые возможности:
//   * Чтение схемы NDJSON и построение плана выгрузки только по отмеченным (sel)
//     узлам.
//   * Параметры отбора: ДатаНачала, ДатаОкончания, Организация, Подразделение.
//   * Режимы разбиения файлов: single | objects | volumes | objects+volumes.
//   * Чанкинг СЕРВЕРНЫХ ВЫЗОВОВ: каждая порция читается отдельным запросом
//     «ВЫБРАТЬ ПЕРВЫЕ N … ГДЕ Ссылка > &Курсор» (keyset-пагинация). Это не даёт
//     одному запросу превысить лимиты памяти rphost. Табличные части читаются
//     батчами по ссылкам уже выбранной порции.
//   * Работа интерактивно (с формы) и программно (ВыгрузитьДанные(...) Экспорт).
//
// Это модуль объекта внешней обработки.
//
// Для тонкого клиента: метод ПрочитатьПорцию() помечен как экспортный, чтобы
// форма могла вызывать его в цикле как &НаСервереБезКонтекста — тогда каждая
// порция = отдельный серверный вызов. При серверном запуске (встроенная
// обработка) достаточно вызвать ВыгрузитьДанные(): память всё равно ограничена
// размером порции, т.к. каждый запрос выбирает не более N записей.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Главная точка входа. Читает схему, выгружает данные согласно ей и параметрам.
//
// Параметры:
//   ПутьСхемы       - Строка - путь к .1cmeta (отредактированному).
//   ПутьВыходной    - Строка - путь к выходному файлу (single/volumes) либо к
//                     каталогу (objects/objects+volumes). База имени берётся
//                     из имени файла без расширения.
//   Параметры       - Структура - см. ПараметрыВыгрузкиПоУмолчанию().
//
// Возвращаемое значение:
//   Структура - Файлы (Массив путей), Строк, Объектов, Томов.
//
Функция ВыгрузитьДанные(ПутьСхемы, ПутьВыходной, Параметры = Неопределено) Экспорт

	Настройки = ПараметрыВыгрузкиПоУмолчанию();
	Если Параметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Настройки, Параметры);
	КонецЕсли;

	План = ПрочитатьСхему(ПутьСхемы);

	Запись = СоздатьКонтекстЗаписи(ПутьВыходной, Настройки, План.Заголовок);

	Для Каждого Объект Из План.Объекты Цикл
		Если НЕ ПоддерживаетсяВыгрузка(Объект.Вид) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ВыгрузитьОбъект(Запись, Объект, Настройки);
		Исключение
			ЗаписатьОшибкуОбъекта(Запись, Объект.ПолноеИмя, ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ЗавершитьЗапись(Запись);

	Результат = Новый Структура;
	Результат.Вставить("Файлы", Запись.СписокФайлов);
	Результат.Вставить("Строк", Запись.ВсегоСтрок);
	Результат.Вставить("Объектов", Запись.ВсегоОбъектов);
	Результат.Вставить("Томов", Запись.НомерТома);
	Возврат Результат;

КонецФункции

Функция ПараметрыВыгрузкиПоУмолчанию() Экспорт
	П = Новый Структура;
	П.Вставить("ДатаНачала", '00010101');
	П.Вставить("ДатаОкончания", '00010101');
	П.Вставить("Организация", Неопределено);
	П.Вставить("Подразделение", Неопределено);
	П.Вставить("РежимРазбиения", "single"); // single | objects | volumes | objects+volumes
	П.Вставить("МаксСтрокВТоме", 100000);
	П.Вставить("ПорцияСервера", 10000);
	П.Вставить("Облако", ПараметрыОблакаПоУмолчанию());
	Возврат П;
КонецФункции

// Опциональные облачные приёмники (прямая выгрузка из 1С). По умолчанию выключены.
// Файл выгрузки пишется ВСЕГДА; облако — это дополнительные приёмники.
Функция ПараметрыОблакаПоУмолчанию() Экспорт
	Транслит = Истина;

	S3 = Новый Структура;
	S3.Вставить("Включить", Ложь);
	S3.Вставить("Архивировать", Истина);             // zip перед загрузкой
	S3.Вставить("Endpoint", "https://storage.yandexcloud.net");
	S3.Вставить("Регион", "ru-central1");
	S3.Вставить("Бакет", "");
	S3.Вставить("AccessKey", "");
	S3.Вставить("SecretKey", "");
	S3.Вставить("Префикс", "");
	S3.Вставить("CACert", "");                        // путь к YandexInternalRootCA.crt

	ClickHouse = Новый Структура;
	ClickHouse.Вставить("Включить", Ложь);
	ClickHouse.Вставить("Хост", "");                  // <id>.mdb.yandexcloud.net
	ClickHouse.Вставить("Порт", 8443);
	ClickHouse.Вставить("База", "onec");
	ClickHouse.Вставить("Пользователь", "admin");
	ClickHouse.Вставить("Пароль", "");
	ClickHouse.Вставить("CACert", "");

	YDB = Новый Структура;
	YDB.Вставить("Включить", Ложь);
	YDB.Вставить("DocApiEndpoint", "");               // https://docapi…/ru-central1/.../<db>
	YDB.Вставить("Регион", "ru-central1");
	YDB.Вставить("AccessKey", "");                    // ключ статического доступа сервис-аккаунта
	YDB.Вставить("SecretKey", "");
	YDB.Вставить("CACert", "");

	Облако = Новый Структура;
	Облако.Вставить("Транслит", Транслит);
	Облако.Вставить("РазмерПакетаClickHouse", 1000);
	Облако.Вставить("РазмерПакетаYDB", 25);           // лимит DynamoDB BatchWriteItem
	Облако.Вставить("S3", S3);
	Облако.Вставить("ClickHouse", ClickHouse);
	Облако.Вставить("YDB", YDB);
	Возврат Облако;
КонецФункции

#КонецОбласти

#Область ЧтениеСхемы

// Читает NDJSON-схему построчно и строит план выгрузки только по отмеченным узлам.
Функция ПрочитатьСхему(ПутьСхемы)

	Чтение = Новый ЧтениеТекста(ПутьСхемы, КодировкаТекста.UTF8);
	УзлыПоId = Новый Соответствие; // id -> Структура(node)
	ДетиПоРодителю = Новый Соответствие; // parentId -> Массив(id)
	Заголовок = Новый Соответствие;

	Стр = Чтение.ПрочитатьСтроку();
	Пока Стр <> Неопределено Цикл
		Если ЗначениеЗаполнено(Стр) Тогда
			Узел = РазобратьСтрокуJSON(Стр);
			Если Узел <> Неопределено Тогда
				Тип = ?(Узел.Получить("$") = Неопределено, "", Узел.Получить("$"));
				Если Тип = "header" Тогда
					Заголовок = Узел;
				ИначеЕсли Тип = "node" Тогда
					Ид = Узел.Получить("id");
					УзлыПоId.Вставить(Ид, Узел);
					Родитель = Узел.Получить("parent");
					Список = ДетиПоРодителю.Получить(Родитель);
					Если Список = Неопределено Тогда
						Список = Новый Массив;
						ДетиПоРодителю.Вставить(Родитель, Список);
					КонецЕсли;
					Список.Добавить(Ид);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Стр = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();

	Объекты = Новый Массив;
	СобратьОбъекты(УзлыПоId, ДетиПоРодителю, Объекты);

	План = Новый Структура;
	План.Вставить("Заголовок", Заголовок);
	План.Вставить("Объекты", Объекты);
	Возврат План;
КонецФункции

// Обходит дерево и собирает прикладные объекты с их отмеченными колонками и ТЧ.
Процедура СобратьОбъекты(УзлыПоId, ДетиПоРодителю, Объекты)
	Для Каждого КЗ Из УзлыПоId Цикл
		Узел = КЗ.Значение;
		Вид = Узел.Получить("kind");
		Если НЕ ПоддерживаетсяВыгрузка(Вид) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ Отмечен(Узел) Тогда
			Продолжить;
		КонецЕсли;

		Объект = Новый Структура;
		Объект.Вставить("ПолноеИмя", Узел.Получить("fullName"));
		Объект.Вставить("Имя", Узел.Получить("name"));
		Объект.Вставить("Вид", Вид);
		Объект.Вставить("Колонки", Новый Массив);                  // имена для запроса
		Объект.Вставить("ТипыКолонок", Новый Соответствие);        // имя -> типы (для облака)
		Объект.Вставить("ТабличныеЧасти", Новый Массив);

		ДетиОбъекта = ДетиПоРодителю.Получить(Узел.Получить("id"));
		Если ДетиОбъекта <> Неопределено Тогда
			Для Каждого ИдРеб Из ДетиОбъекта Цикл
				Ребенок = УзлыПоId.Получить(ИдРеб);
				ВидРеб = Ребенок.Получить("kind");
				Если ВидРеб = "TabularSection" Или ВидРеб = "StandardTabularSection" Тогда
					Если НЕ Отмечен(Ребенок) Тогда
						Продолжить;
					КонецЕсли;
					Собранные = СобратьКолонки(УзлыПоId, ДетиПоРодителю, ИдРеб);
					ТЧ = Новый Структура;
					ТЧ.Вставить("Имя", Ребенок.Получить("name"));
					ТЧ.Вставить("ПолноеИмя", Объект.ПолноеИмя + "." + Ребенок.Получить("name"));
					ТЧ.Вставить("Колонки", Собранные.Имена);
					ТЧ.Вставить("ТипыКолонок", Собранные.Типы);
					Если ТЧ.Колонки.Количество() > 0 Тогда
						Объект.ТабличныеЧасти.Добавить(ТЧ);
					КонецЕсли;
				ИначеЕсли ЭтоПолеДанных(ВидРеб) И Отмечен(Ребенок) Тогда
					ИмяПоля = Ребенок.Получить("name");
					Объект.ТипыКолонок.Вставить(ИмяПоля, Ребенок.Получить("types"));
					// «Ссылка» всегда выгружается отдельным префиксом запроса — не дублируем
					Если НЕ (СсылочныйОбъект(Вид) И ИмяПоля = "Ссылка") Тогда
						Объект.Колонки.Добавить(ИмяПоля);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если Объект.Колонки.Количество() > 0 Или Объект.ТабличныеЧасти.Количество() > 0 Тогда
			Объекты.Добавить(Объект);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СобратьКолонки(УзлыПоId, ДетиПоРодителю, РодительId)
	Имена = Новый Массив;
	Типы = Новый Соответствие;
	Дети = ДетиПоРодителю.Получить(РодительId);
	Если Дети <> Неопределено Тогда
		Для Каждого Ид Из Дети Цикл
			Узел = УзлыПоId.Получить(Ид);
			Если ЭтоПолеДанных(Узел.Получить("kind")) И Отмечен(Узел) Тогда
				Имя = Узел.Получить("name");
				Имена.Добавить(Имя);
				Типы.Вставить(Имя, Узел.Получить("types"));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("Имена,Типы", Имена, Типы);
КонецФункции

Функция Отмечен(Узел)
	Значение = Узел.Получить("sel");
	Возврат Значение = Неопределено Или Значение = Истина;
КонецФункции

Функция ЭтоПолеДанных(Вид)
	Возврат Вид = "Attribute" Или Вид = "StandardAttribute" Или Вид = "Dimension"
		Или Вид = "Resource" Или Вид = "AccountingFlag" Или Вид = "ExtDimensionAccountingFlag";
КонецФункции

Функция ПоддерживаетсяВыгрузка(Вид)
	Поддерживаемые = "Catalog,Document,ChartOfCharacteristicTypes,ChartOfAccounts,"
		+ "ChartOfCalculationTypes,Task,BusinessProcess,ExchangePlan,"
		+ "InformationRegister,AccumulationRegister,AccountingRegister,CalculationRegister";
	Возврат СтрНайти("," + Поддерживаемые + ",", "," + Вид + ",") > 0;
КонецФункции

Функция СсылочныйОбъект(Вид)
	Возврат Вид = "Catalog" Или Вид = "Document" Или Вид = "ChartOfCharacteristicTypes"
		Или Вид = "ChartOfAccounts" Или Вид = "ChartOfCalculationTypes"
		Или Вид = "Task" Или Вид = "BusinessProcess" Или Вид = "ExchangePlan";
КонецФункции

#КонецОбласти

#Область ВыгрузкаОбъектов

Процедура ВыгрузитьОбъект(Запись, Объект, Настройки)

	НачатьОбъект(Запись, Объект);

	Если СсылочныйОбъект(Объект.Вид) Тогда
		ВыгрузитьСсылочныйОбъект(Запись, Объект, Настройки);
	Иначе
		ВыгрузитьРегистр(Запись, Объект, Настройки);
	КонецЕсли;

	Запись.ВсегоОбъектов = Запись.ВсегоОбъектов + 1;
КонецПроцедуры

// Ссылочные объекты: keyset-пагинация по Ссылке. Каждая порция — отдельный запрос.
Процедура ВыгрузитьСсылочныйОбъект(Запись, Объект, Настройки)

	ПоляОбъекта = ПоляДоступныеВТаблице(Объект.ПолноеИмя);
	ОтборДок = СтрокаОтбораСсылочного(Объект, ПоляОбъекта, Настройки);

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ &Порция
		|	Т.Ссылка КАК Ссылка," + Символы.ПС
		+ СписокПолейЗапроса(Объект.Колонки, "Т") + Символы.ПС
		+ "ИЗ " + Объект.ПолноеИмя + " КАК Т" + Символы.ПС
		+ "ГДЕ Т.Ссылка > &Курсор" + ОтборДок + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО Т.Ссылка";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Порция", Настройки.ПорцияСервера);
	УстановитьПараметрыОтбора(Запрос, Настройки);
	Курсор = ПустаяСсылкаОбъекта(Объект.ПолноеИмя);

	Пока Истина Цикл
		Запрос.УстановитьПараметр("Курсор", Курсор);
		Результат = Запрос.Выполнить(); // <- отдельный серверный запрос на каждую порцию
		Выборка = Результат.Выбрать();

		СсылкиПорции = Новый Массив;
		КоличествоВПорции = 0;
		Пока Выборка.Следующий() Цикл
			ЗаписатьСтрокуДанных(Запись, Объект.ПолноеИмя, СтрокаВСоответствие(Выборка, Объект.Колонки, "Ссылка"));
			СсылкиПорции.Добавить(Выборка.Ссылка);
			Курсор = Выборка.Ссылка;
			КоличествоВПорции = КоличествоВПорции + 1;
		КонецЦикла;

		// Табличные части — батчем по ссылкам уже выбранной порции.
		Для Каждого ТЧ Из Объект.ТабличныеЧасти Цикл
			Если СсылкиПорции.Количество() > 0 Тогда
				ВыгрузитьТабличнуюЧасть(Запись, ТЧ, СсылкиПорции);
			КонецЕсли;
		КонецЦикла;

		ЗаписатьКонецЧанка(Запись, Объект.ПолноеИмя, КоличествоВПорции, Строка(Курсор.УникальныйИдентификатор()));

		Если КоличествоВПорции < Настройки.ПорцияСервера Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ВыгрузитьТабличнуюЧасть(Запись, ТЧ, СсылкиПорции)
	НачатьОбъектТЧ(Запись, ТЧ);
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Т.Ссылка КАК Ссылка,
		|	Т.НомерСтроки КАК НомерСтроки," + Символы.ПС
		+ СписокПолейЗапроса(ТЧ.Колонки, "Т") + Символы.ПС
		+ "ИЗ " + ТЧ.ПолноеИмя + " КАК Т" + Символы.ПС
		+ "ГДЕ Т.Ссылка В (&Ссылки)" + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО Т.Ссылка, Т.НомерСтроки";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылки", СсылкиПорции);
	Выборка = Запрос.Выполнить().Выбрать();
	Колонки = Новый Массив;
	Колонки.Добавить("НомерСтроки");
	Для Каждого К Из ТЧ.Колонки Цикл
		Колонки.Добавить(К);
	КонецЦикла;
	Пока Выборка.Следующий() Цикл
		ЗаписатьСтрокуДанных(Запись, ТЧ.ПолноеИмя, СтрокаВСоответствие(Выборка, Колонки, "Ссылка"));
	КонецЦикла;
КонецПроцедуры

// Регистры: чанкинг по окнам периода (если периодичны), иначе один запрос.
Процедура ВыгрузитьРегистр(Запись, Объект, Настройки)
	ИмяТаблицы = Объект.ПолноеИмя;
	ПоляОбъекта = ПоляДоступныеВТаблице(ИмяТаблицы);
	ЕстьПериод = ПоляОбъекта.Получить("Период") <> Неопределено;

	Если ЕстьПериод И ЗначениеЗаполнено(Настройки.ДатаНачала) И ЗначениеЗаполнено(Настройки.ДатаОкончания) Тогда
		Шаг = 86400 * 30; // окно чанкинга по периоду — 30 дней
		НачалоОкна = НачалоДня(Настройки.ДатаНачала);
		Пока НачалоОкна <= Настройки.ДатаОкончания Цикл
			КонецОкна = Мин(КонецДня(НачалоОкна + Шаг), КонецДня(Настройки.ДатаОкончания));
			ВыгрузитьОкноРегистра(Запись, Объект, Настройки, НачалоОкна, КонецОкна, Истина);
			НачалоОкна = НачалоДня(КонецОкна) + 86400;
		КонецЦикла;
	Иначе
		ВыгрузитьОкноРегистра(Запись, Объект, Настройки, '00010101', '00010101', Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура ВыгрузитьОкноРегистра(Запись, Объект, Настройки, НачалоОкна, КонецОкна, ПоПериоду)
	ПоляОбъекта = ПоляДоступныеВТаблице(Объект.ПолноеИмя);
	Условия = Новый Массив;
	Если ПоПериоду Тогда
		Условия.Добавить("Т.Период МЕЖДУ &НачалоОкна И &КонецОкна");
	КонецЕсли;
	Если ПоляОбъекта.Получить("Организация") <> Неопределено И ЗначениеЗаполнено(Настройки.Организация) Тогда
		Условия.Добавить("Т.Организация = &Организация");
	КонецЕсли;
	Если ПоляОбъекта.Получить("Подразделение") <> Неопределено И ЗначениеЗаполнено(Настройки.Подразделение) Тогда
		Условия.Добавить("Т.Подразделение = &Подразделение");
	КонецЕсли;

	ТекстГде = "";
	Если Условия.Количество() > 0 Тогда
		ТекстГде = Символы.ПС + "ГДЕ " + СтрСоединить(Условия, Символы.ПС + "	И ");
	КонецЕсли;

	ТекстЗапроса =
		"ВЫБРАТЬ" + Символы.ПС
		+ СписокПолейЗапроса(Объект.Колонки, "Т") + Символы.ПС
		+ "ИЗ " + Объект.ПолноеИмя + " КАК Т" + ТекстГде;

	Запрос = Новый Запрос(ТекстЗапроса);
	Если ПоПериоду Тогда
		Запрос.УстановитьПараметр("НачалоОкна", НачалоОкна);
		Запрос.УстановитьПараметр("КонецОкна", КонецОкна);
	КонецЕсли;
	УстановитьПараметрыОтбора(Запрос, Настройки);

	Выборка = Запрос.Выполнить().Выбрать(); // окно ограничивает объём этого вызова
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		ЗаписатьСтрокуДанных(Запись, Объект.ПолноеИмя, СтрокаВСоответствие(Выборка, Объект.Колонки, ""));
		Количество = Количество + 1;
	КонецЦикла;
	ЗаписатьКонецЧанка(Запись, Объект.ПолноеИмя, Количество, XMLСтрока(КонецОкна));
КонецПроцедуры

#КонецОбласти

#Область ПостроениеЗапросов

Функция СписокПолейЗапроса(Колонки, Алиас)
	Если Колонки.Количество() = 0 Тогда
		Возврат "	" + Алиас + ".Ссылка КАК Пусто_";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого Поле Из Колонки Цикл
		Части.Добавить("	" + Алиас + "." + Поле + " КАК " + Поле);
	КонецЦикла;
	Возврат СтрСоединить(Части, "," + Символы.ПС);
КонецФункции

Функция СтрокаОтбораСсылочного(Объект, ПоляОбъекта, Настройки)
	Условия = Новый Массив;
	// Период — по реквизиту Дата (документы).
	Если Объект.Вид = "Document" И ПоляОбъекта.Получить("Дата") <> Неопределено Тогда
		Если ЗначениеЗаполнено(Настройки.ДатаНачала) Тогда
			Условия.Добавить("Т.Дата >= &ДатаНачала");
		КонецЕсли;
		Если ЗначениеЗаполнено(Настройки.ДатаОкончания) Тогда
			Условия.Добавить("Т.Дата <= &ДатаОкончания");
		КонецЕсли;
	КонецЕсли;
	Если ПоляОбъекта.Получить("Организация") <> Неопределено И ЗначениеЗаполнено(Настройки.Организация) Тогда
		Условия.Добавить("Т.Организация = &Организация");
	КонецЕсли;
	Если ПоляОбъекта.Получить("Подразделение") <> Неопределено И ЗначениеЗаполнено(Настройки.Подразделение) Тогда
		Условия.Добавить("Т.Подразделение = &Подразделение");
	КонецЕсли;
	Если Условия.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Символы.ПС + "	И " + СтрСоединить(Условия, Символы.ПС + "	И ");
КонецФункции

Процедура УстановитьПараметрыОтбора(Запрос, Настройки)
	Если ЗначениеЗаполнено(Настройки.ДатаНачала) Тогда
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Настройки.ДатаНачала));
	КонецЕсли;
	Если ЗначениеЗаполнено(Настройки.ДатаОкончания) Тогда
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Настройки.ДатаОкончания));
	КонецЕсли;
	Если ЗначениеЗаполнено(Настройки.Организация) Тогда
		Запрос.УстановитьПараметр("Организация", Настройки.Организация);
	КонецЕсли;
	Если ЗначениеЗаполнено(Настройки.Подразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Настройки.Подразделение);
	КонецЕсли;
КонецПроцедуры

// Множество имён полей, реально доступных в таблице объекта (для безопасных отборов).
Функция ПоляДоступныеВТаблице(ПолноеИмя)
	Поля = Новый Соответствие;
	Попытка
		ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Исключение
		Возврат Поля;
	КонецПопытки;
	Если ОбъектМД = Неопределено Тогда
		Возврат Поля;
	КонецЕсли;
	ДобавитьИменаКоллекции(Поля, БезопасноеСвойство(ОбъектМД, "Реквизиты"));
	ДобавитьИменаКоллекции(Поля, БезопасноеСвойство(ОбъектМД, "Измерения"));
	ДобавитьИменаКоллекции(Поля, БезопасноеСвойство(ОбъектМД, "Ресурсы"));
	ДобавитьИменаКоллекции(Поля, БезопасноеСвойство(ОбъектМД, "СтандартныеРеквизиты"));
	Возврат Поля;
КонецФункции

Процедура ДобавитьИменаКоллекции(Поля, Коллекция)
	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Элемент Из Коллекция Цикл
		Поля.Вставить(Элемент.Имя, Истина);
	КонецЦикла;
КонецПроцедуры

Функция БезопасноеСвойство(Объект, ИмяСвойства)
	Значение = Неопределено;
	Попытка
		Значение = Объект[ИмяСвойства];
	Исключение
		Значение = Неопределено;
	КонецПопытки;
	Возврат Значение;
КонецФункции

Функция ПустаяСсылкаОбъекта(ПолноеИмя)
	Запрос = Новый Запрос("ВЫБРАТЬ ЗНАЧЕНИЕ(" + ПолноеИмя + ".ПустаяСсылка) КАК Ссылка");
	Возврат Запрос.Выполнить().Выгрузить()[0].Ссылка;
КонецФункции

#КонецОбласти

#Область ЗаписьФайлов

Функция СоздатьКонтекстЗаписи(ПутьВыходной, Настройки, ЗаголовокСхемы)
	Запись = Новый Структура;
	Запись.Вставить("Настройки", Настройки);
	Запись.Вставить("ЗаголовокСхемы", ЗаголовокСхемы);
	Запись.Вставить("ПутьВыходной", ПутьВыходной);
	Запись.Вставить("БазаИмени", БазаИмениФайла(ПутьВыходной));
	Запись.Вставить("Каталог", КаталогФайла(ПутьВыходной));
	Запись.Вставить("ТекущийФайл", Неопределено); // ЗаписьТекста
	Запись.Вставить("СписокФайлов", Новый Массив);
	Запись.Вставить("НомерТома", 0);
	Запись.Вставить("СтрокВТекущемТоме", 0);
	Запись.Вставить("ВсегоСтрок", 0);
	Запись.Вставить("ВсегоОбъектов", 0);
	Запись.Вставить("ТекущийОбъект", "");

	// Облачные приёмники (опционально). Файл пишется всегда; это дополнительно.
	Облако = ?(Настройки.Свойство("Облако"), Настройки.Облако, Неопределено);
	Запись.Вставить("Облако", Облако);
	Запись.Вставить("CHВключен", Облако <> Неопределено И Облако.ClickHouse.Включить);
	Запись.Вставить("YDBВключен", Облако <> Неопределено И Облако.YDB.Включить);
	Запись.Вставить("S3Включен", Облако <> Неопределено И Облако.S3.Включить);
	Запись.Вставить("РаскладкаПоОбъекту", Новый Соответствие);
	Запись.Вставить("ТаблицаПоОбъекту", Новый Соответствие);
	Запись.Вставить("БуферCH", Новый Соответствие);
	Запись.Вставить("БуферYDB", Новый Соответствие);
	Возврат Запись;
КонецФункции

Процедура НачатьОбъект(Запись, Объект)
	Запись.ТекущийОбъект = Объект.ПолноеИмя;
	Если Запись.Настройки.РежимРазбиения = "objects" Или Запись.Настройки.РежимРазбиения = "objects+volumes" Тогда
		ОткрытьНовыйФайл(Запись, БезопасноеИмя(Объект.ПолноеИмя));
	ИначеЕсли Запись.ТекущийФайл = Неопределено Тогда
		ОткрытьНовыйФайл(Запись, "");
	КонецЕсли;
	Маркер = Новый Соответствие;
	Маркер.Вставить("$", "object");
	Маркер.Вставить("obj", Объект.ПолноеИмя);
	Маркер.Вставить("kind", Объект.Вид);
	Маркер.Вставить("columns", Объект.Колонки);
	ПисатьСтроку(Запись, Маркер);

	Если ОблачныеПриёмникиАктивны(Запись) Тогда
		КолонкиСхемы = Новый Массив;
		Если СсылочныйОбъект(Объект.Вид) Тогда
			КолонкиСхемы.Добавить(КолонкаСхемы("Ссылка", Неопределено, "self_ref"));
		КонецЕсли;
		ДобавитьКолонкиСхемы(КолонкиСхемы, Объект.Колонки, Объект.ТипыКолонок);
		ЗарегистрироватьПриёмник(Запись, Объект.ПолноеИмя, КолонкиСхемы);
	КонецЕсли;
КонецПроцедуры

Процедура НачатьОбъектТЧ(Запись, ТЧ)
	Маркер = Новый Соответствие;
	Маркер.Вставить("$", "object");
	Маркер.Вставить("obj", ТЧ.ПолноеИмя);
	Маркер.Вставить("kind", "TabularSection");
	Маркер.Вставить("columns", ТЧ.Колонки);
	ПисатьСтроку(Запись, Маркер);

	Если ОблачныеПриёмникиАктивны(Запись) Тогда
		КолонкиСхемы = Новый Массив;
		КолонкиСхемы.Добавить(КолонкаСхемы("Ссылка", Неопределено, "self_ref"));
		КолонкиСхемы.Добавить(КолонкаСхемы("НомерСтроки", Неопределено, "line_number"));
		ДобавитьКолонкиСхемы(КолонкиСхемы, ТЧ.Колонки, ТЧ.ТипыКолонок);
		ЗарегистрироватьПриёмник(Запись, ТЧ.ПолноеИмя, КолонкиСхемы);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьСтрокуДанных(Запись, ПолноеИмя, Данные)
	Стр = Новый Соответствие;
	Стр.Вставить("$", "row");
	Стр.Вставить("obj", ПолноеИмя);
	Стр.Вставить("data", Данные);
	ПисатьСтроку(Запись, Стр);
	ОтправитьВПриёмники(Запись, ПолноеИмя, Данные);
	Запись.ВсегоСтрок = Запись.ВсегоСтрок + 1;
	Запись.СтрокВТекущемТоме = Запись.СтрокВТекущемТоме + 1;
	// Многотомность: при превышении лимита открываем новый том.
	Если (Запись.Настройки.РежимРазбиения = "volumes" Или Запись.Настройки.РежимРазбиения = "objects+volumes")
		И Запись.СтрокВТекущемТоме >= Запись.Настройки.МаксСтрокВТоме Тогда
		ОткрытьНовыйФайл(Запись, ?(Запись.Настройки.РежимРазбиения = "objects+volumes", БезопасноеИмя(Запись.ТекущийОбъект), ""));
		// после переключения тома повторяем маркер объекта, чтобы том был самодостаточным
		Маркер = Новый Соответствие;
		Маркер.Вставить("$", "object");
		Маркер.Вставить("obj", ПолноеИмя);
		ПисатьСтроку(Запись, Маркер);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьКонецЧанка(Запись, ПолноеИмя, Количество, Курсор)
	Маркер = Новый Соответствие;
	Маркер.Вставить("$", "chunkEnd");
	Маркер.Вставить("obj", ПолноеИмя);
	Маркер.Вставить("count", Количество);
	Маркер.Вставить("cursor", Курсор);
	ПисатьСтроку(Запись, Маркер);
КонецПроцедуры

Процедура ЗаписатьОшибкуОбъекта(Запись, ПолноеИмя, ТекстОшибки)
	Если Запись.ТекущийФайл = Неопределено Тогда
		ОткрытьНовыйФайл(Запись, "");
	КонецЕсли;
	Маркер = Новый Соответствие;
	Маркер.Вставить("$", "error");
	Маркер.Вставить("obj", ПолноеИмя);
	Маркер.Вставить("message", ТекстОшибки);
	ПисатьСтроку(Запись, Маркер);
КонецПроцедуры

Процедура ОткрытьНовыйФайл(Запись, Суффикс)
	Если Запись.ТекущийФайл <> Неопределено Тогда
		Запись.ТекущийФайл.Закрыть();
	КонецЕсли;
	Запись.НомерТома = Запись.НомерТома + 1;
	Запись.СтрокВТекущемТоме = 0;

	Части = Новый Массив;
	Части.Добавить(Запись.БазаИмени);
	Если ЗначениеЗаполнено(Суффикс) Тогда
		Части.Добавить(Суффикс);
	КонецЕсли;
	Если Запись.Настройки.РежимРазбиения = "volumes" Или Запись.Настройки.РежимРазбиения = "objects+volumes" Тогда
		Части.Добавить("v" + Формат(Запись.НомерТома, "ЧЦ=3; ЧВН="));
	КонецЕсли;
	ИмяФайла = СтрСоединить(Части, ".") + ".1cdata";
	ПутьФайла = ОбъединитьПути(Запись.Каталог, ИмяФайла);

	Запись.ТекущийФайл = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	Запись.СписокФайлов.Добавить(ПутьФайла);
	ПисатьЗаголовокФайла(Запись);
КонецПроцедуры

Процедура ПисатьЗаголовокФайла(Запись)
	Заголовок = Новый Соответствие;
	Заголовок.Вставить("$", "header");
	Заголовок.Вставить("format", "1cdata-ndjson");
	Заголовок.Вставить("version", 1);
	Заголовок.Вставить("schema", ?(Запись.ЗаголовокСхемы.Получить("config") = Неопределено, "", Запись.ЗаголовокСхемы.Получить("config")));
	Заголовок.Вставить("generated", XMLСтрока(ТекущаяДата()));
	Фильтры = Новый Соответствие;
	Фильтры.Вставить("dateStart", ?(ЗначениеЗаполнено(Запись.Настройки.ДатаНачала), XMLСтрока(Запись.Настройки.ДатаНачала), ""));
	Фильтры.Вставить("dateEnd", ?(ЗначениеЗаполнено(Запись.Настройки.ДатаОкончания), XMLСтрока(Запись.Настройки.ДатаОкончания), ""));
	Фильтры.Вставить("organization", ?(ЗначениеЗаполнено(Запись.Настройки.Организация), Строка(Запись.Настройки.Организация), ""));
	Фильтры.Вставить("subdivision", ?(ЗначениеЗаполнено(Запись.Настройки.Подразделение), Строка(Запись.Настройки.Подразделение), ""));
	Заголовок.Вставить("filters", Фильтры);
	Разбиение = Новый Соответствие;
	Разбиение.Вставить("mode", Запись.Настройки.РежимРазбиения);
	Разбиение.Вставить("maxRowsPerVolume", Запись.Настройки.МаксСтрокВТоме);
	Заголовок.Вставить("split", Разбиение);
	Заголовок.Вставить("volume", Запись.НомерТома);
	ПисатьСтроку(Запись, Заголовок);
КонецПроцедуры

Процедура ЗавершитьЗапись(Запись)
	Если Запись.ТекущийФайл <> Неопределено Тогда
		Подвал = Новый Соответствие;
		Подвал.Вставить("$", "footer");
		Подвал.Вставить("rows", Запись.ВсегоСтрок);
		Подвал.Вставить("objects", Запись.ВсегоОбъектов);
		Подвал.Вставить("volumes", Запись.НомерТома);
		ПисатьСтроку(Запись, Подвал);
		Запись.ТекущийФайл.Закрыть();
		Запись.ТекущийФайл = Неопределено;
	КонецЕсли;

	// Дослать остатки облачных приёмников и (опц.) выгрузить файлы в S3.
	СброситьОстаткиПриёмников(Запись);
	ОтправитьФайлыВS3(Запись);
КонецПроцедуры

Процедура ПисатьСтроку(Запись, Значение)
	Запись.ТекущийФайл.ЗаписатьСтроку(СериализоватьВСтроку(Значение));
КонецПроцедуры

#КонецОбласти

#Область ОблачныеПриёмники

Функция ОблачныеПриёмникиАктивны(Запись)
	Возврат Запись.CHВключен Или Запись.YDBВключен;
КонецФункции

Функция КолонкаСхемы(Имя, Типы, Спец = "")
	Возврат Новый Структура("Имя,Типы,Спец", Имя, Типы, Спец);
КонецФункции

Процедура ДобавитьКолонкиСхемы(КолонкиСхемы, Колонки, ТипыКолонок)
	Для Каждого Имя Из Колонки Цикл
		КолонкиСхемы.Добавить(КолонкаСхемы(Имя, ТипыКолонок.Получить(Имя)));
	КонецЦикла;
КонецПроцедуры

Процедура ЗарегистрироватьПриёмник(Запись, ПолноеИмя, КолонкиСхемы)
	Транслит = Запись.Облако.Транслит;
	Запись.РаскладкаПоОбъекту.Вставить(ПолноеИмя,
		ОблачныеПриёмники.ПостроитьРаскладку(КолонкиСхемы, Транслит));
	Запись.ТаблицаПоОбъекту.Вставить(ПолноеИмя,
		ОблачныеПриёмники.ИмяТаблицыSQL(ПолноеИмя, Транслит));
	Запись.БуферCH.Вставить(ПолноеИмя, Новый Массив);
	Запись.БуферYDB.Вставить(ПолноеИмя, Новый Массив);
КонецПроцедуры

Процедура ОтправитьВПриёмники(Запись, ПолноеИмя, Данные)
	Если Запись.CHВключен Тогда
		Буфер = Запись.БуферCH.Получить(ПолноеИмя);
		Если Буфер <> Неопределено Тогда
			Буфер.Добавить(Данные);
			Если Буфер.Количество() >= Запись.Облако.РазмерПакетаClickHouse Тогда
				СброситьБуферCH(Запись, ПолноеИмя);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Запись.YDBВключен Тогда
		Буфер = Запись.БуферYDB.Получить(ПолноеИмя);
		Если Буфер <> Неопределено Тогда
			Буфер.Добавить(Данные);
			Если Буфер.Количество() >= Запись.Облако.РазмерПакетаYDB Тогда
				СброситьБуферYDB(Запись, ПолноеИмя);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура СброситьБуферCH(Запись, ПолноеИмя)
	Буфер = Запись.БуферCH.Получить(ПолноеИмя);
	Если Буфер = Неопределено Или Буфер.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ОблачныеПриёмники.ОтправитьПакетВClickHouse(
		Запись.Облако.ClickHouse,
		Запись.ТаблицаПоОбъекту.Получить(ПолноеИмя),
		Запись.РаскладкаПоОбъекту.Получить(ПолноеИмя),
		Буфер);
	Запись.БуферCH.Вставить(ПолноеИмя, Новый Массив);
КонецПроцедуры

Процедура СброситьБуферYDB(Запись, ПолноеИмя)
	Буфер = Запись.БуферYDB.Получить(ПолноеИмя);
	Если Буфер = Неопределено Или Буфер.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ОблачныеПриёмники.ОтправитьПакетВYDB(
		Запись.Облако.YDB,
		Запись.ТаблицаПоОбъекту.Получить(ПолноеИмя),
		Запись.РаскладкаПоОбъекту.Получить(ПолноеИмя),
		Буфер);
	Запись.БуферYDB.Вставить(ПолноеИмя, Новый Массив);
КонецПроцедуры

Процедура СброситьОстаткиПриёмников(Запись)
	Если Запись.CHВключен Тогда
		Для Каждого КЗ Из Запись.БуферCH Цикл
			СброситьБуферCH(Запись, КЗ.Ключ);
		КонецЦикла;
	КонецЕсли;
	Если Запись.YDBВключен Тогда
		Для Каждого КЗ Из Запись.БуферYDB Цикл
			СброситьБуферYDB(Запись, КЗ.Ключ);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОтправитьФайлыВS3(Запись)
	Если НЕ Запись.S3Включен Тогда
		Возврат;
	КонецЕсли;
	S3 = Запись.Облако.S3;
	Если S3.Архивировать Тогда
		ПутьАрхива = ОбъединитьПути(Запись.Каталог, Запись.БазаИмени + ".zip");
		ОблачныеПриёмники.АрхивироватьФайлы(Запись.СписокФайлов, ПутьАрхива);
		ОблачныеПриёмники.ОтправитьФайлВObjectStorage(S3, ПутьАрхива);
	Иначе
		Для Каждого Путь Из Запись.СписокФайлов Цикл
			ОблачныеПриёмники.ОтправитьФайлВObjectStorage(S3, Путь);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Сериализация

// Преобразует строку выборки в Соответствие колонка -> JSON-значение.
Функция СтрокаВСоответствие(Выборка, Колонки, ИсключитьПоле)
	Данные = Новый Соответствие;
	Если ИсключитьПоле = "Ссылка" Тогда
		Данные.Вставить("Ссылка", ЗначениеВJSON(Выборка.Ссылка));
	КонецЕсли;
	Для Каждого Поле Из Колонки Цикл
		Данные.Вставить(Поле, ЗначениеВJSON(Выборка[Поле]));
	КонецЦикла;
	Возврат Данные;
КонецФункции

// Сериализует значение поля в JSON-совместимый вид.
Функция ЗначениеВJSON(Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗ = ТипЗнч(Значение);
	Если ТипЗ = Тип("Строка") Или ТипЗ = Тип("Число") Или ТипЗ = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗ = Тип("Дата") Тогда
		Возврат ?(Значение = '00010101', Неопределено, XMLСтрока(Значение));
	ИначеЕсли ТипЗ = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	ИначеЕсли ТипЗ = Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено; // бинарные данные не выгружаем
	Иначе
		// Предполагаем ссылочный тип.
		Попытка
			Если НЕ ЗначениеЗаполнено(Значение) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Ссылка = Новый Соответствие;
			Ссылка.Вставить("$ref", Строка(Значение.УникальныйИдентификатор()));
			Ссылка.Вставить("meta", Значение.Метаданные().ПолноеИмя());
			Ссылка.Вставить("p", Строка(Значение));
			Возврат Ссылка;
		Исключение
			Возврат Строка(Значение);
		КонецПопытки;
	КонецЕсли;
КонецФункции

Функция СериализоватьВСтроку(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция РазобратьСтрокуJSON(Стр)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Стр);
	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина); // Истина -> читать в Соответствие
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область РаботаСФайлами

Функция БазаИмениФайла(Путь)
	Файл = Новый Файл(Путь);
	Имя = Файл.ИмяБезРасширения;
	Возврат ?(ЗначениеЗаполнено(Имя), Имя, "data");
КонецФункции

Функция КаталогФайла(Путь)
	Файл = Новый Файл(Путь);
	Если Файл.Существует() И Файл.ЭтоКаталог() Тогда
		Возврат Путь;
	КонецЕсли;
	Возврат Файл.Путь;
КонецФункции

Функция ОбъединитьПути(Каталог, Имя)
	Разделитель = ?(СтрНайти(Каталог, "\") > 0, "\", "/");
	Если ЗначениеЗаполнено(Каталог) И Прав(Каталог, 1) <> Разделитель Тогда
		Возврат Каталог + Разделитель + Имя;
	КонецЕсли;
	Возврат Каталог + Имя;
КонецФункции

Функция БезопасноеИмя(ПолноеИмя)
	Результат = СтрЗаменить(ПолноеИмя, ".", "_");
	Результат = СтрЗаменить(Результат, " ", "_");
	Возврат Результат;
КонецФункции

#КонецОбласти
